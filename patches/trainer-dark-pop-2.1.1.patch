+namespace dingosdk::grab_fix {
+namespace {
+namespace sstate = addr::skater_state;
+
+constexpr const char* version = "0.3.2";
+constexpr const char* legacy_setting = "DingoGameplay.UseLegacyFootPlants";
+constexpr std::uint64_t legacy_check_ms = 1000;
+constexpr std::uint8_t trigger_down = 102; // of 255, as the grind exit control counts a press
+
+// ---- the bail guard --------------------------------------------------------------------------
+// Grab Swap starts when the skater bails, is reset, or goes into a footplant with a grab trigger
+// held: the game loses the grab's end, and until a trigger is let go while riding (landing with
+// the grab held, or a tap on the ground) every grab ignores the tweak and comes out
+// frontside/backside. A bail with no trigger held leaves nothing behind.
+//   From a bail, a reset or a footplant with LT/RT held, the game keeps reading that trigger held
+//   through the wipeout, the ragdoll and the respawn (the 300s/700s, where the player has no
+//   control) until the first step riding again or back in the trick air (201); then it reads the
+//   pad again, and lets the grab go on the board, as landing with it held does (0.2.1, the release
+//   that clears the bug: a trigger down as the skater enters riding, let go there).
+//   0.3.2: on foot (the 500s) a held trigger rolls the skater, so a hold is never kept there: it
+//   is let go and the bail remembered; on the first steps riding again, with the right stick
+//   centred (a tweak would turn it into a modified grab), the game reads that trigger pressed for
+//   tap_steps physics steps (and at least one pad read), then let go: the "tap" (0.3.1). Skipped
+//   if the player has that trigger down by then (their own release does it).
+constexpr std::uint32_t guard_lt = 1, guard_rt = 2;
+constexpr std::uint64_t guard_timeout_ms = 10000;  // a hold never riding again (a menu, a level change): let go anyway
+constexpr std::uint64_t pending_timeout_ms = 120000; // a remembered bail never followed by riding: forgotten
+constexpr std::uint32_t tap_steps_default = 15, tap_steps_max = 30, tap_steps_cap = 60; // physics steps
+constexpr std::int16_t stick_centred = 8000;         // of 32767: the right stick near enough the centre for the tap
+struct GuardEvent {
+    std::uint32_t kind{}; // 1 held (footplant), 2 hold let go on the board, 3 hold let go on the timeout, 5 bail remembered, 6 tapped, 7 tap skipped
+    std::uint32_t triggers{}, state{}, from{}, steps{}, reads{};
+};
+
+struct GrabFix {
+    std::atomic<std::uintptr_t> base{};
+    std::atomic<bool> started{}, wanted{true};
+    std::atomic<bool> guard_wanted{true}, guard_on{}, listening{};
+    // The pad's triggers as pressed (input threads, per pad slot), and the triggers the game is
+    // kept reading held (set and cleared on the physics thread).
+    std::array<std::atomic<std::uint32_t>, 4> pressed{};
+    std::atomic<std::uint32_t> held_over{};
+    std::uint64_t held_since{};                 // physics thread
+    // 0.3.1, the tap: the triggers let go at a bail off the board, to be tapped on the first riding
+    // step; the tap in progress (the game reads these pressed), how many steps and pad reads so far.
+    std::atomic<bool> hold_mode{};              // "grabfix guard mode hold": 0.2.1's hold everywhere (the roll on foot comes back)
+    std::atomic<std::uint32_t> tap_steps{tap_steps_default};
+    std::uint32_t pending{};                    // physics thread
+    std::uint64_t pending_since{};              // physics thread
+    std::atomic<std::uint32_t> tapping{};
+    std::atomic<std::uint32_t> tap_reads{};
+    std::array<std::atomic<std::int16_t>, 4> stick{}; // the right stick's larger axis, per pad slot (input threads)
+    std::uint32_t tap_done{};                   // physics thread
+    std::uint32_t guard_last_state{};           // physics thread
+    std::uintptr_t guard_last_context{};        // physics thread
+    std::atomic<std::uint64_t> guard_count{};
+    std::atomic<int> legacy{}; // 0 not found, 1 on, 2 off
+    std::filesystem::path settings_path;
+    // The legacy footplant setting (game update thread only).
+    std::atomic<std::uint64_t> next_legacy{}; // zeroed by the console to apply a change at once
+    std::uint64_t started_tick{};
+    bool legacy_applied{}, legacy_missing_logged{};
+    std::uint32_t legacy_writes{};
+    // Physics thread -> client tick.
+    std::mutex queue_lock;
+    std::vector<GuardEvent> guard_events;
+};
+GrabFix& grab() {
+    static auto* value = new GrabFix; // process lifetime: hooks may call in until exit
+    return *value;
+}
+
+// ---- settings ------------------------------------------------------------------------------
+std::filesystem::path settings_file() {
+    PWSTR raw{};
+    std::filesystem::path result;
+    if (SUCCEEDED(SHGetKnownFolderPath(FOLDERID_LocalAppData, 0, nullptr, &raw)) && raw)
+        result = std::filesystem::path(raw) / L"ReSkate" / L"grabfix" / L"settings.txt";
+    if (raw) CoTaskMemFree(raw);
+    return result;
+}
+// The settings file's format: 2 from 0.2.1. An older file's on/off for the two fixes is not read,
+// so both start on after the update. (A "probe=" line from 0.2.x is ignored.)
+constexpr int settings_version = 2;
+void load_settings(GrabFix& g) {
+    if (g.settings_path.empty()) return;
+    std::ifstream in(g.settings_path);
+    std::string line;
+    std::vector<std::string> lines;
+    bool current = false;
+    while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (line == "version=" + std::to_string(settings_version)) current = true;
+        lines.push_back(line);
+    }
+    if (!current) return;
+    for (const auto& entry : lines) {
+        if (entry == "enabled=1") g.wanted.store(true);
+        else if (entry == "enabled=0") g.wanted.store(false);
+        else if (entry == "guard=1") g.guard_wanted.store(true);
+        else if (entry == "guard=0") g.guard_wanted.store(false);
+        else if (entry == "mode=hold") g.hold_mode.store(true);
+        else if (entry == "mode=tap") g.hold_mode.store(false);
+        else if (entry.starts_with("tap=")) {
+            const auto n = std::strtoul(entry.c_str() + 4, nullptr, 10);
+            if (n >= 1 && n <= tap_steps_max) g.tap_steps.store(static_cast<std::uint32_t>(n));
+        }
+    }
+}
+void save_settings(GrabFix& g) {
+    if (g.settings_path.empty()) return;
+    std::error_code error;
+    std::filesystem::create_directories(g.settings_path.parent_path(), error);
+    std::ofstream out(g.settings_path, std::ios::trunc);
+    out << "version=" << settings_version << "\n";
+    out << "enabled=" << (g.wanted.load() ? 1 : 0) << "\n";
+    out << "guard=" << (g.guard_wanted.load() ? 1 : 0) << "\n";
+    out << "mode=" << (g.hold_mode.load() ? "hold" : "tap") << "\n";
+    out << "tap=" << g.tap_steps.load() << "\n";
+}
+
+// ---- input side ----------------------------------------------------------------------------
+// Any thread the game polls its pad from: the bail guard's filter (after any other filter).
+void guard_pad(unsigned user, overlay::GamepadValues& pad) noexcept {
+    auto& g = grab();
+    auto& slot = g.pressed[user & 3];
+    auto pressed = slot.load(std::memory_order_relaxed);
+    const auto track = [&](std::uint8_t value, std::uint32_t bit) {
+        if (pressed & bit) { if (value <= 51) pressed &= ~bit; }
+        else if (value >= trigger_down) pressed |= bit;
+    };
+    track(pad.left_trigger, guard_lt);
+    track(pad.right_trigger, guard_rt);
+    slot.store(pressed, std::memory_order_relaxed);
+    const auto axis = [](std::int16_t v) { return static_cast<std::int16_t>(v < 0 ? (v == INT16_MIN ? INT16_MAX : -v) : v); };
+    g.stick[user & 3].store(std::max(axis(pad.right_x), axis(pad.right_y)), std::memory_order_relaxed);
+    const auto held = g.held_over.load(std::memory_order_acquire) | g.tapping.load(std::memory_order_acquire);
+    if (held & guard_lt) pad.left_trigger = 255;
+    if (held & guard_rt) pad.right_trigger = 255;
+    if (g.tapping.load(std::memory_order_relaxed)) g.tap_reads.fetch_add(1, std::memory_order_acq_rel);
+}
+std::uint32_t triggers_pressed(GrabFix& g) noexcept {
+    std::uint32_t any{};
+    for (const auto& slot : g.pressed) any |= slot.load(std::memory_order_relaxed);
+    return any;
+}
+bool stick_centred_now(GrabFix& g) noexcept {
+    for (const auto& slot : g.stick)
+        if (slot.load(std::memory_order_relaxed) > stick_centred) return false;
+    return true;
+}
+void guard_event(GrabFix& g, std::uint32_t kind, std::uint32_t triggers, std::uint32_t state, std::uint32_t from, std::uint32_t steps = 0,
+                 std::uint32_t reads = 0) {
+    std::lock_guard lock(g.queue_lock);
+    if (g.guard_events.size() < 64) g.guard_events.push_back({kind, triggers, state, from, steps, reads});
+}
+bool riding(std::uint32_t state) noexcept { return state >= 100 && state < 200; }
+bool on_board(std::uint32_t state) noexcept { const auto f = state / 100; return f == 1 || f == 2 || f == 4 || f == 6; }
+bool off_board(std::uint32_t state) noexcept { const auto f = state / 100; return f == 3 || f == 5 || f == 7; }
+bool footplant(std::uint32_t state) noexcept { return state / 100 == 6; }
+bool on_foot(std::uint32_t state) noexcept { return state / 100 == 5; }
+// Physics thread, every step.
+//   A bail, reset or footplant with a trigger held: the hold, ended on the first step riding or in
+//   the trick air (201). On foot (the 500s) the hold is let go and remembered instead (tap mode;
+//   hold mode keeps it, 0.2.1's behaviour), and the first steps riding again, with the right stick
+//   centred, tap that trigger.
+void guard_step(GrabFix& g, const NoBailSkater& skater, std::uint32_t state, bool wipeout) {
+    const auto now = GetTickCount64();
+    const bool hold_mode = g.hold_mode.load(std::memory_order_relaxed);
+    const bool reset = g.guard_last_context && skater.context != g.guard_last_context;
+    const bool bailed = wipeout || reset || (on_board(g.guard_last_state) && off_board(state));
+    const bool planted = footplant(state) && !footplant(g.guard_last_state);
+    auto held = g.held_over.load(std::memory_order_acquire);
+    // The tap in progress: over once the game has read it long enough (and at least once).
+    if (const auto tapping = g.tapping.load(std::memory_order_acquire)) {
+        ++g.tap_done;
+        const auto reads = g.tap_reads.load(std::memory_order_acquire);
+        const auto want = std::min(g.tap_steps.load(std::memory_order_relaxed), tap_steps_max);
+        if ((g.tap_done >= want && reads >= 1) || g.tap_done >= tap_steps_cap || !riding(state)) {
+            g.tapping.store(0, std::memory_order_release);
+            guard_event(g, 6, tapping, state, g.guard_last_state, g.tap_done, reads);
+        }
+    }
+    if (bailed || planted) {
+        const auto pressed = triggers_pressed(g) & ~held & ~g.pending;
+        if (pressed) {
+            g.guard_count.fetch_add(1, std::memory_order_relaxed);
+            if (hold_mode || !on_foot(state)) {
+                held = g.held_over.fetch_or(pressed, std::memory_order_acq_rel) | pressed;
+                g.held_since = now;
+                guard_event(g, 1, pressed, state, g.guard_last_state);
+            } else {
+                g.pending |= pressed;
+                g.pending_since = now;
+                guard_event(g, 5, pressed, state, g.guard_last_state);
+            }
+        }
+    }
+    // A hold on foot (a bail or footplant that ends with the skater walking): let go now, tap later.
+    if (held && on_foot(state) && !hold_mode) {
+        g.held_over.store(0, std::memory_order_release);
+        g.pending |= held;
+        g.pending_since = now;
+        guard_event(g, 5, held, state, g.guard_last_state);
+        held = 0;
+    } else if (held && (riding(state) || state == sstate::board_air_states[1])) {
+        g.held_over.store(0, std::memory_order_release);
+        guard_event(g, 2, held, state, g.guard_last_state);
+    } else if (held && now - g.held_since > guard_timeout_ms) {
+        g.held_over.store(0, std::memory_order_release);
+        guard_event(g, 3, held, state, g.guard_last_state);
+    }
+    // The remembered bail: tapped on the first riding steps (two in a row, no wipeout, the right stick
+    // centred), unless the player has the trigger down.
+    if (g.pending && riding(state) && riding(g.guard_last_state) && !wipeout && !g.tapping.load(std::memory_order_relaxed) &&
+        stick_centred_now(g)) {
+        const auto own = triggers_pressed(g);
+        const auto tap = g.pending & ~own;
+        if (own & g.pending) guard_event(g, 7, g.pending & own, state, g.guard_last_state);
+        g.pending = 0;
+        if (tap) {
+            g.tap_done = 0;
+            g.tap_reads.store(0, std::memory_order_release);
+            g.tapping.store(tap, std::memory_order_release);
+        }
+    } else if (g.pending && now - g.pending_since > pending_timeout_ms) {
+        g.pending = 0;
+    }
+    g.guard_last_state = state;
+    g.guard_last_context = skater.context;
+}
+void on_step(const NoBailSkater& skater, float, bool wipeout) noexcept {
+    auto& g = grab();
+    try {
+        if (!g.guard_on.load(std::memory_order_acquire)) return;
+        std::uint32_t state{};
+        if (memory::peek(skater.context + sstate::physics_state_offset, state)) guard_step(g, skater, state, wipeout);
+    } catch (...) {
+    }
+}
+
+// ---- client side ---------------------------------------------------------------------------
+bool listen(GrabFix& g) {
+    if (g.listening.load(std::memory_order_acquire)) return true;
+    if (!no_bail_available() || !add_no_bail_step_listener(&on_step)) return false;
+    g.listening.store(true, std::memory_order_release);
+    return true;
+}
+void unlisten(GrabFix& g) {
+    if (!g.listening.exchange(false)) return;
+    remove_no_bail_step_listener(&on_step);
+}
+bool set_guard(GrabFix& g, bool on) {
+    if (on == g.guard_on.load(std::memory_order_acquire)) return true;
+    if (on) {
+        if (!listen(g)) return false;
+        g.held_over.store(0, std::memory_order_release);
+        g.tapping.store(0, std::memory_order_release);
+        g.pending = 0;
+        DingoSDKOverlaySetGamepadGuard(&guard_pad);
+        g.guard_on.store(true, std::memory_order_release);
+        logging::log(logging::Level::info, logging::Channel::skater,
+                     "Grab Fix bail guard on ({}): a grab held through a bail, reset or footplant is kept held until riding and let go there{} (Grab Swap).",
+                     g.hold_mode.load() ? "hold" : std::format("tap, {} step(s)", g.tap_steps.load()),
+                     g.hold_mode.load() ? "" : "; on foot it is let go and tapped on the first riding steps instead");
+    } else {
+        g.guard_on.store(false, std::memory_order_release);
+        DingoSDKOverlaySetGamepadGuard(nullptr);
+        g.held_over.store(0, std::memory_order_release);
+        g.tapping.store(0, std::memory_order_release);
+        unlisten(g);
+        logging::write(logging::Level::info, logging::Channel::skater, "Grab Fix bail guard off.");
+    }
+    return true;
+}
+const char* trigger_names(std::uint32_t t) { return t == (guard_lt | guard_rt) ? "LT and RT" : t == guard_lt ? "LT" : "RT"; }
+void log_guard(GrabFix& g) {
+    std::vector<GuardEvent> events;
+    {
+        std::lock_guard lock(g.queue_lock);
+        events.swap(g.guard_events);
+    }
+    for (const auto& e : events) {
+        switch (e.kind) {
+        case 1:
+            logging::log(logging::Level::info, logging::Channel::skater,
+                         "Grab Fix bail guard: {} held through a {} (state {} -> {}); the game keeps it held until riding or back in the air (or let go on foot).",
+                         trigger_names(e.triggers), footplant(e.state) ? "footplant" : "bail/reset", e.from, e.state);
+            break;
+        case 2: case 3:
+            logging::log(logging::Level::info, logging::Channel::skater, "Grab Fix bail guard: {} let go {} (state {}).", trigger_names(e.triggers),
+                         e.kind == 2 ? (e.state == sstate::board_air_states[1] ? "in the air" : "on the board") : "after 10 s without riding", e.state);
+            break;
+        case 5:
+            logging::log(logging::Level::info, logging::Channel::skater,
+                         "Grab Fix bail guard: {} let go on foot (state {} -> {}); it will be tapped on the first riding steps.",
+                         trigger_names(e.triggers), e.from, e.state);
+            break;
+        case 6:
+            logging::log(logging::Level::info, logging::Channel::skater,
+                         "Grab Fix bail guard: {} tapped on the board for {} step(s), {} pad read(s) (state {}).", trigger_names(e.triggers), e.steps,
+                         e.reads, e.state);
+            break;
+        default:
+            logging::log(logging::Level::info, logging::Channel::skater,
+                         "Grab Fix bail guard: {} not tapped, the player has it down (state {}); their own release will do it.",
+                         trigger_names(e.triggers), e.state);
+        }
+    }
+}
+// Game update thread: the legacy footplant setting follows the on/off choice.
+void keep_legacy(GrabFix& g) {
+    const auto now = GetTickCount64();
+    if (now < g.next_legacy.load(std::memory_order_acquire)) return;
+    g.next_legacy.store(now + legacy_check_ms, std::memory_order_release);
+    const auto value = named_setting_value(legacy_setting);
+    if (!value) {
+        g.legacy.store(0, std::memory_order_release);
+        if (!g.legacy_missing_logged && now - g.started_tick > 60000) {
+            g.legacy_missing_logged = true;
+            logging::log(logging::Level::warning, logging::Channel::skater,
+                         "Grab Fix: the game has not registered {} after a minute; Sticky Grab is not fixed this session.", legacy_setting);
+        }
+        return;
+    }
+    const bool on = *value == "1";
+    if (g.wanted.load(std::memory_order_acquire)) {
+        if (!on) {
+            const auto result = change_named_setting(legacy_setting, "1", false);
+            const bool failed = result.starts_with("error");
+            ++g.legacy_writes;
+            // The first write, and then every tenth: something keeps setting it back (a session's host, the console).
+            if (g.legacy_writes == 1 || g.legacy_writes % 10 == 0 || failed)
+                logging::log(failed ? logging::Level::warning : logging::Level::info, logging::Channel::skater,
+                             "Grab Fix: legacy footplants on (write {}): {}", g.legacy_writes, result);
+            if (!failed) g.legacy_applied = true;
+            g.legacy.store(failed ? 2 : 1, std::memory_order_release);
+            return;
+        }
+        g.legacy.store(1, std::memory_order_release);
+        return;
+    }
+    if (g.legacy_applied) {
+        const auto result = change_named_setting(legacy_setting, {}, true);
+        g.legacy_applied = false;
+        g.legacy_writes = 0;
+        logging::log(logging::Level::info, logging::Channel::skater, "Grab Fix off: legacy footplants given back to the game ({}).", result);
+        g.next_legacy.store(0, std::memory_order_release);
+        return;
+    }
+    g.legacy.store(on ? 1 : 2, std::memory_order_release);
+}
+std::string status_text(GrabFix& g) {
+    if (!g.started.load(std::memory_order_acquire)) return "Grab Fix is unavailable.";
+    const int legacy = g.legacy.load();
+    return std::format("Grab Fix {}: Sticky Grab fix (legacy footplants) {}{}. Bail guard (Grab Swap) {}{}{}.", version,
+                       g.wanted.load() ? "ON" : "off",
+                       legacy == 1 ? ", the setting is on" : legacy == 2 ? ", the setting is off" : ", waiting for the game's setting",
+                       g.guard_on.load() ? "ON" : "off",
+                       g.guard_on.load() ? std::format(" ({} bail(s) caught)", g.guard_count.load())
+                       : no_bail_available() ? std::string{} : std::string(" (unavailable: No Bail's hooks did not start)"),
+                       g.hold_mode.load() ? ", mode hold" : std::format(", mode tap ({} step(s))", g.tap_steps.load()));
+}
+} // namespace
+
+bool available() noexcept { return grab().started.load(std::memory_order_acquire); }
+bool enabled() noexcept { return grab().wanted.load(std::memory_order_acquire); }
+bool guard_available() noexcept { return available() && no_bail_available(); }
+int legacy_footplants() noexcept { return grab().legacy.load(std::memory_order_acquire); }
+bool guard() noexcept { return grab().guard_on.load(std::memory_order_acquire); }
+
+bool start(std::uintptr_t image_base) noexcept {
+    auto& g = grab();
+    if (g.started.load(std::memory_order_acquire)) return true;
+    try {
+        g.settings_path = settings_file();
+        load_settings(g);
+    } catch (...) {}
+    g.base.store(image_base, std::memory_order_release);
+    g.started_tick = GetTickCount64();
+    g.started.store(true, std::memory_order_release);
+    logging::log(logging::Level::info, logging::Channel::skater, "Grab Fix {} started: Sticky Grab fix {}, bail guard {}.", version,
+                 g.wanted.load() ? "on" : "off", g.guard_wanted.load() ? "on" : "off");
+    if (g.guard_wanted.load() && !set_guard(g, true))
+        logging::write(logging::Level::warning, logging::Channel::skater,
+                       "Grab Fix bail guard could not start: it follows the skater's physics steps through No Bail's hooks (not started, or no free step listener).");
+    return true;
+}
+
+void on_client_tick(std::uintptr_t) noexcept {
+    auto& g = grab();
+    if (!g.started.load(std::memory_order_acquire)) return;
+    try {
+        keep_legacy(g);
+        log_guard(g);
+    } catch (...) {}
+}
+
+std::string command(const std::vector<std::string>& words) {
+    auto& g = grab();
+    const auto verb = words.empty() ? std::string("status") : words[0];
+    const auto arg = words.size() > 1 ? words[1] : std::string{};
+    if (verb == "status" || verb.empty()) return status_text(g);
+    if (!g.started.load()) return status_text(g);
+    if (verb == "on" || verb == "off") {
+        g.wanted.store(verb == "on");
+        g.next_legacy.store(0, std::memory_order_release); // the next tick applies it
+        try { save_settings(g); } catch (...) {}
+        return status_text(g);
+    }
+    if (verb == "guard" && arg == "mode") {
+        const auto mode = words.size() > 2 ? words[2] : std::string{};
+        if (mode != "tap" && mode != "hold") return "Usage: grabfix guard mode tap|hold";
+        g.hold_mode.store(mode == "hold");
+        try { save_settings(g); } catch (...) {}
+        return status_text(g);
+    }
+    if (verb == "guard" && arg == "tap") {
+        const auto n = words.size() > 2 ? std::strtoul(words[2].c_str(), nullptr, 10) : 0ul;
+        if (n < 1 || n > tap_steps_max) return std::format("Usage: grabfix guard tap <steps> (1 to {})", tap_steps_max);
+        g.tap_steps.store(static_cast<std::uint32_t>(n));
+        try { save_settings(g); } catch (...) {}
+        return status_text(g);
+    }
+    if (verb == "guard") {
+        if (arg != "on" && arg != "off") return "Usage: grabfix guard on|off, grabfix guard mode tap|hold, grabfix guard tap <steps>";
+        const bool on = arg == "on";
+        if (!set_guard(g, on)) return "The bail guard could not start: No Bail's hooks did not start, or no step listener is free.";
+        g.guard_wanted.store(on);
+        try { save_settings(g); } catch (...) {}
+        return status_text(g);
+    }
+    return "Usage: grabfix on|off|status, grabfix guard on|off, grabfix guard mode tap|hold, grabfix guard tap <steps>";
+}
+} // namespace dingosdk::grab_fix
diff --git a/Extension/Skater/grab_fix.h b/Extension/Skater/grab_fix.h
new file mode 100644
index 0000000..d5f8ff3
--- /dev/null
+++ b/Extension/Skater/grab_fix.h
@@ -0,0 +1,55 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// Grab Fix: the two grab bugs skate. picked up after Season 2.
+//
+//   Sticky Grab (A/X modified grabs: benihana, dog piss, judo nose, one foot tail): the game
+//     misses their release and holds the grab until landing. The game still has its old footplant
+//     path behind the engine setting DingoGameplay.UseLegacyFootPlants (added after Season 2, off
+//     by default); with it on the release registers again (tested 19 Oct 2026). While Grab Fix is
+//     on, that setting is turned on on every launch and kept on, offline and in sessions. Turned
+//     off, Grab Fix gives the setting back to the game's value.
+//
+//   Grab Swap (tweak the board to the nose or tail, press a trigger, get a frontside/backside grab
+//     instead): starts with a bail, a reset or a footplant while LT/RT is held, and lasts until a
+//     trigger is let go while riding (tested 19 Oct 2026: a bail with no trigger held leaves
+//     nothing behind; a clean landing with the grab held clears it). The state it keeps is in the
+//     game's animation data, out of reach, so the fix is the bail guard ("grabfix guard on|off"):
+//     from a bail, reset or footplant with a trigger held, the game keeps reading that trigger
+//     held until the first step the skater is riding again (100s) or back in the trick air (201),
+//     so the grab is let go on the board, as landing with it held does. Nothing is pressed that
+//     the player did not press.
+//     0.3.2: the hold goes on through the wipeout, ragdoll and respawn (no control there) and
+//     ends on the first riding step, as 0.2.1's did, but never on foot (the 500s), where a held
+//     trigger rolls the skater: there it is let go and the bail remembered, and on the first
+//     riding steps after the mount, with the right stick centred, the game reads the trigger
+//     pressed for a few physics steps ("grabfix guard tap <steps>", default 15), then let go: the
+//     tap, the same on-board release. Skipped if the player has the trigger down by then.
+//     "grabfix guard mode hold" keeps the hold on foot too (0.2.1).
+//
+//   0.3.0 (the tournament edition): the probe (logs\grab-probe-*.csv, logs\grab-snap-*.bin) is
+//     gone; nothing is written to disk but the settings file and ReSkate.log.
+//
+// Settings are kept in %LOCALAPPDATA%\ReSkate\grabfix\settings.txt. Console:
+// grabfix on|off|status, grabfix guard on|off, grabfix guard mode tap|hold, grabfix guard tap <steps>.
+namespace dingosdk::grab_fix {
+// Once, at runtime start, after No Bail (the bail guard follows the skater's physics steps through
+// its hooks; the legacy footplant setting does not need them).
+bool start(std::uintptr_t image_base) noexcept;
+// The client tick, on the game update thread (the thread that owns the engine settings).
+void on_client_tick(std::uintptr_t client) noexcept;
+// The console verbs.
+std::string command(const std::vector<std::string>& words);
+
+// For the menus, any thread.
+bool available() noexcept;
+bool enabled() noexcept;
+// The bail guard can run (No Bail's hooks started).
+bool guard_available() noexcept;
+// The legacy footplant setting as last read: 0 not found yet, 1 on, 2 off.
+int legacy_footplants() noexcept;
+// The bail guard switched on and installed.
+bool guard() noexcept;
+}
diff --git a/Extension/Skater/grab_fix_commands.cpp b/Extension/Skater/grab_fix_commands.cpp
new file mode 100644
index 0000000..63a4276
--- /dev/null
+++ b/Extension/Skater/grab_fix_commands.cpp
