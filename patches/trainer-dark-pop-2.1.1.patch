diff --git a/Engine/Game/Settings/multiplayer_settings_lock.h b/Engine/Game/Settings/multiplayer_settings_lock.h
index b5fd239..34ec194 100644
--- a/Engine/Game/Settings/multiplayer_settings_lock.h
+++ b/Engine/Game/Settings/multiplayer_settings_lock.h
@@ -42,4 +42,16 @@ inline bool locked_in_multiplayer(std::string_view name) noexcept {
     return false;
 }
 inline bool multiplayer_settings_locked() noexcept { return multiplayer_session_active(); }
+// The tournament edition (tournament_build): the simulation clock (SimulationTime: the game speed, slow motion, the
+// pause) can never be changed by the player, in or out of a session. Only ReSkate's own internal changes may touch it.
+inline bool locked_in_tournament(std::string_view name) noexcept {
+    using namespace settings_lock_detail;
+    if (!tournament_build) return false;
+    auto group = name.substr(0, name.find('.'));
+    if (group.size() == name.size()) return false;
+    constexpr std::string_view suffix = "Settings";
+    if (group.size() > suffix.size() && same(group.substr(group.size() - suffix.size()), suffix))
+        group.remove_suffix(suffix.size());
+    return same(group, "SimulationTime");
+}
 } // namespace dingosdk
