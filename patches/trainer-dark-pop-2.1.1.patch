+    std::uintptr_t client{}, entity{};
+    std::atomic<ULONGLONG> expires{};
+    std::atomic<std::uint32_t> pumps{};
+    std::atomic<float> gained{}, given{}, speed{};
+    std::atomic<std::uint32_t> steps{};
+    // Physics thread only.
+    std::uint32_t count{};
+    bool primed{}, running{};
+    float energy{}, sum{}, credit{};
+};
