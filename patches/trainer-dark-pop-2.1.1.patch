+float dark_pop_seconds(std::int64_t ticks) noexcept {
+    LARGE_INTEGER f{};
+    QueryPerformanceFrequency(&f);
+    return f.QuadPart > 0 ? static_cast<float>(static_cast<double>(ticks) / static_cast<double>(f.QuadPart)) : 0.0f;
