+            "legacy footplants on and keeps them on.", grab_on, grab_console))
+        send_console(menu, callbacks, grab_on ? "grabfix on" : "grabfix off");
+    if (grab.enabled && grab.legacy == 0) note("Waiting for the game's footplant setting...");
+    else if (grab.enabled && grab.legacy == 2) warn("The game's legacy footplant setting is off; see ReSkate.log.");
+    bool guard_on = grab.guard;
+    if (toggle_row(menu, "Bail guard", "Grab Swap: bailing, resetting or footplanting with a grab held no longer breaks your next grabs. "
+            "The game lets that grab go on the first step you're riding again; on foot it is let go and tapped once you're riding "
+            "(console: grabfix guard tap <steps>, grabfix guard mode tap|hold).", guard_on, grab_console && grab.guard_available))
+        send_console(menu, callbacks, guard_on ? "grabfix guard on" : "grabfix guard off");
+    if (!grab.guard_available) warn("The bail guard needs No Bail's hooks, which did not start for this game build.");
+    end_card();
