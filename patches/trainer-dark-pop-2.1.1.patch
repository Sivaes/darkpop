+void grab_fix_addon(SkateMenu& menu, const Model& model, const CallbacksV3& callbacks) {
+    const auto& grab = model.grab_fix;
+    const bool grab_console = grab.available && callbacks.queue_console_command;
+    begin_card(menu, "grab-fix", "GRAB FIX", "Fixes for the grab bugs skate. picked up in Season 3");
