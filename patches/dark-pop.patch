+// ---- Dark Pop ----------------------------------------------------------------------
+// The first Dark Pop, unchanged in what it does: D-pad Right held as a flight ends turns the landing into a new
+// pop. It used to need No Bail switched on, both to find the local skater and to stop the game bailing around
+// the pop. Now it finds the skater from the lease's owner (published with No Bail off too), and asks for No
+// Bail's protection itself, only while it matters (dark_pop_protecting, added to the lease by the client tick).
+constexpr std::uint32_t dark_pop_state = 200;
+constexpr std::uint64_t dark_pop_cooldown_ms = 1000; // one forced pop per second at most
+constexpr std::uint64_t dark_pop_flight_ms = 3000;   // protection after a pop if no landing is seen first
+constexpr std::uint64_t dark_pop_settle_ms = 300;    // protection after the landing that follows a pop
+bool dark_pop_air(std::uint32_t state) noexcept { return state >= 200 && state < 300; }
+struct DarkPop {
+    std::atomic<bool> enabled{}, airborne{}, popped{};
+    std::atomic<std::uint64_t> held_until{}, cooldown_until{}, protect_until{}, count{}, landings{};
+    std::atomic<std::uint32_t> from{}, to{}, landed{};
+};
+DarkPop& dark_pop() { static auto* value = new DarkPop; return *value; }
+// `wanted` is what the game chose and `kept` what No Bail's swap left of it (it only swaps while protected).
+// A held press meeting the end of a flight becomes the pop state; otherwise `kept` stands.
+std::uint32_t dark_pop_override(std::uintptr_t selector, std::uint32_t current, std::uint32_t wanted, std::uint32_t kept) noexcept {
+    auto& d = dark_pop();
+    if (!d.enabled.load(std::memory_order_relaxed) || !local_owner(selector, &Owner::selector)) return kept;
+    const auto now = GetTickCount64();
+    if (dark_pop_air(current) && !dark_pop_air(wanted) && now < d.held_until.load(std::memory_order_relaxed) &&
+        now >= d.cooldown_until.load(std::memory_order_relaxed)) {
+        d.cooldown_until.store(now + dark_pop_cooldown_ms, std::memory_order_relaxed);
+        d.protect_until.store(now + dark_pop_flight_ms, std::memory_order_relaxed);
+        d.popped.store(true, std::memory_order_relaxed);
+        d.airborne.store(true, std::memory_order_relaxed);
+        d.from.store(current, std::memory_order_relaxed);
+        d.to.store(wanted, std::memory_order_relaxed);
+        d.count.fetch_add(1, std::memory_order_acq_rel);
+        return dark_pop_state;
+    }
+    if (d.popped.load(std::memory_order_relaxed) && dark_pop_air(current) && !dark_pop_air(kept)) {
+        // The flight the pop started has ended: keep protecting for a moment while the landing settles.
+        d.popped.store(false, std::memory_order_relaxed);
+        d.protect_until.store(now + dark_pop_settle_ms, std::memory_order_relaxed);
+        d.landed.store(kept, std::memory_order_relaxed);
+        d.landings.fetch_add(1, std::memory_order_acq_rel);
+    }
+    d.airborne.store(dark_pop_air(kept), std::memory_order_relaxed);
+    return kept;
+}
+extern "C" void DingoSDKOverlayReadControllerInput(dingosdk::ControllerInput* input, bool allow_menu);
+constexpr std::size_t fast_probe_capacity = 8192; // rows; about a minute of choices per drain interval at most
+struct FastProbe {
+    std::atomic<bool> enabled{};
+    std::atomic<std::uint64_t> head{}, tail{};
+    FastProbeRow rows[fast_probe_capacity];
+};
+FastProbe& fast_probe() { static auto* value = new FastProbe; return *value; }
+void fast_probe_record(std::uintptr_t selector, std::uint32_t current, std::uint32_t wanted, std::uint32_t chosen) noexcept {
+    auto& f = fast_probe();
+    if (!f.enabled.load(std::memory_order_relaxed)) return;
+    Owner owner;
+    if (!local_owner(selector, &Owner::selector, &owner)) return;
+    const auto head = f.head.load(std::memory_order_relaxed);
+    if (head - f.tail.load(std::memory_order_acquire) >= fast_probe_capacity) return;
+    auto& row = f.rows[head % fast_probe_capacity];
+    LARGE_INTEGER now{};
+    QueryPerformanceCounter(&now);
+    row.ticks = now.QuadPart;
+    row.current = current;
+    row.wanted = wanted;
+    row.chosen = chosen;
+    dingosdk::ControllerInput pad;
+    DingoSDKOverlayReadControllerInput(&pad, false);
+    row.buttons = pad.available ? pad.buttons : 0u;
+    for (int i = 0; i < 8; ++i) { unsigned word{}; row.words[i] = read(owner.context + 0x13c4 + 4 * i, word) ? word : 0u; }
+    for (int i = 0; i < 10; ++i) { unsigned word{}; row.words[8 + i] = read(owner.context + 0x140c + 4 * i, word) ? word : 0u; }
+    f.head.store(head + 1, std::memory_order_release);
+}
