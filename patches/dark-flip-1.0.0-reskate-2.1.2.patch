new file mode 100644
index 0000000..449d4d9
--- /dev/null
+++ b/Extension/Skater/dark_flip.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// Dark Flip: body flips out of a dark catch (the skater on the upside-down board).
+//
+// 0.3.0 (`darkflip on|off`, on by default): in a dark catch the anim graph refuses a new grab intent,
+// so a body flip cannot start. Dark Flip hooks the game's bool state setter and keeps the grab intent
+// (Bool.Intent.Right/LeftHandGrab) on while LT / RT is held with the stick's flip intent on, as the
+// heelflip glitch does;
+// the game's own body flip, assist and height rule then run, without the grab pose. ReSkate.log gets
+// a line per dark air saying what was written and whether the flip started.
+//
+// The probe (0.1.x) is still in: skate. lets a body flip start once a
+// grab (LT / RT) has registered for part of the air (PhysicsAirstates.BodyFlipMinGrabTimeFraction),
+// and in a dark catch the grab press is refused. The heelflip / kickflip / impossible glitch (grab
+// pressed just before the dark catch) gets the grab in first and body flips dark. The probe records
+// what the game does on every physics step of every air, so the refusal can be found:
+//
+//   %game%\logs\dark-flip-steps-<date>-<time>.csv   a row per physics step, from 20 steps before
+//     takeoff to 30 after landing: the pad as the game read it, the physics state, the board's and
+//     the skeleton root's up axes and spins (dark = board up y below 0), a window of the skater
+//     context's words (+0x1380..+0x143c: the jump, landing, graph signal and request flags), and the
+//     core's trick state and its animation output whenever they changed since the row before.
+//   %game%\logs\dark-flip-states-<date>-<time>.csv  every byte of the skater's animation state pages
+//     that changed on a recorded step, with the game state's name where one is known
+//     (Animation/Dingo/Bool.Intent..., Float.Anim..., found by `darkflip names`, a search of
+//     the game's memory; otherwise the raw page and place, named later from a names file).
+//   %game%\logs\dark-flip-names-<date>-<time>.txt   the names that search found, page and place.
+//   ReSkate.log                                     a line per air: buttons, dark or not, how far the
+//     body turned, how it ended; and the markers.
+//
+// Console: darkflip status | darkflip probe on|off | darkflip mark <text> | darkflip names
+namespace dingosdk::dark_flip {
+inline constexpr const char* version = "1.0.0";
+// Once, at runtime start, after No Bail (the probe follows the skater's physics steps through its hooks).
+bool start(std::uintptr_t image_base) noexcept;
+// The client tick, on the game update thread: writes what the physics thread queued.
+void on_client_tick(std::uintptr_t client) noexcept;
+// The console verbs.
+std::string command(const std::vector<std::string>& words);
+// The switch (the menu's toggle): on by default, kept in %LOCALAPPDATA%\ReSkate\dark-flip.ini.
+bool enabled() noexcept;
+bool set_enabled(bool on) noexcept;
+// Whether the fix can act now: the grab hook is in and its game states are found.
+bool ready() noexcept;
+bool hook_in() noexcept;
+}
diff --git a/Extension/Skater/dark_flip_commands.cpp b/Extension/Skater/dark_flip_commands.cpp
new file mode 100644
index 0000000..0116ddd
--- /dev/null
+++ b/Extension/Skater/dark_flip_commands.cpp
@@ -0,0 +1,46 @@
+#include "dark_flip.h"
+#include "Extension/Console/commands.h"
+
+// Dark Flip's console verbs (dark_flip.h).
+namespace dingosdk::console {
+void register_dark_flip_commands(Commands &registry) {
+    struct Verb {
+        const char *name;
+        const char *description;
+        const char *usage;
+    };
+    const Verb verbs[]{
+        {"on", "Dark Flip: a grab press (LT / RT) with the stick in a dark catch starts the body flip", nullptr},
+        {"off", "Dark Flip: off (dark catches refuse the grab, as in the game)", nullptr},
+        {"watch", "Dark Flip: watch which game code reads and writes the grab intent (60 s or 10 dark airs)", "on|off"},
+        {"status", "Dark Flip: on or off, and whether it is ready", nullptr},
+        {"probe", "Dark Flip: record every air to logs\\dark-flip-*.csv", "on|off"},
+        {"mark", "Dark Flip: tag the next airs in the logs (normal, glitch, fail...)", "<text>"},
+        {"names", "Dark Flip: search the game's memory again for the skater's game state names", nullptr},
+    };
+    for (const auto &verb : verbs) {
+        std::vector<Argument> arguments;
+        if (verb.usage) {
+            auto rest = argument(verb.usage, Type::text, true);
+            rest.rest = true;
+            arguments.push_back(std::move(rest));
+        }
+        auto entry = action(std::string("darkflip ") + verb.name, verb.description, Group::gameplay, std::move(arguments));
+        entry.run = [name = std::string(verb.name)](const Model &, const Values &values, const Output &out) {
+            std::vector<std::string> words{name};
+            if (!values.empty())
+                if (const auto *text = std::get_if<std::string>(&values[0])) {
+                    std::size_t start = 0;
+                    while (start < text->size()) {
+                        auto end = text->find(' ', start);
+                        if (end == std::string::npos) end = text->size();
+                        if (end > start) words.push_back(text->substr(start, end - start));
+                        start = end + 1;
+                    }
+                }
+            out(dark_flip::command(words));
+        };
+        registry.add(std::move(entry));
+    }
+}
+} // namespace dingosdk::console
diff --git a/Extension/Trainer/trainer_page.cpp b/Extension/Trainer/trainer_page.cpp
