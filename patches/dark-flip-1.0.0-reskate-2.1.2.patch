+// ---- physics side --------------------------------------------------------------------------
+// Body 0 of a physics object (the board's root, the skeleton's first ragdoll body): up axis and spin.
+bool root_body(std::uintptr_t physics, std::uintptr_t vtable, std::uint32_t expected, std::array<float, 3>& up, std::array<float, 3>& spin) noexcept {
+    std::uintptr_t type{}, bodies{}, owner{};
+    std::uint32_t count{};
+    if (!pointer(physics) || !memory::peek(physics, type) || type != vtable || !memory::peek(physics + sstate::physics_bodies_offset, bodies) ||
+        !pointer(bodies) || !memory::peek(bodies, count) || count != expected)
+        return false;
+    if (!memory::peek(bodies + sstate::body_owner_offset, owner) || owner != physics || !memory::peek(bodies + body_up_offset, up) ||
+        !memory::peek(bodies + sstate::body_spin_offset, spin))
+        return false;
+    return std::all_of(up.begin(), up.end(), sane) && std::all_of(spin.begin(), spin.end(), sane);
+}
+bool read_bodies(const NoBailSkater& skater, Row& row) noexcept {
+    std::uintptr_t holder{}, board{}, rig_physics{};
+    if (memory::peek(skater.core + sstate::board_holder_offset, holder) && pointer(holder) &&
+        memory::peek(holder + sstate::board_physics_offset, board))
+        row.board_ok = root_body(board, skater.base + sstate::board_physics_vtable, sstate::board_body_count, row.board_up, row.board_spin);
+    if (skater.rig && memory::peek(skater.rig + sstate::rig_physics_offset, rig_physics))
+        row.rig_ok = root_body(rig_physics, skater.base + sstate::rig_physics_vtable, sstate::rig_body_count, row.rig_up, row.rig_spin);
+    return row.board_ok || row.rig_ok;
+}
+std::uintptr_t find_states_block(std::uintptr_t base, std::uintptr_t entity) noexcept {
+    std::uintptr_t collection{}, owner{};
+    std::uint8_t count{};
+    if (!pointer(entity) || !memory::peek(entity + component_collection, collection) || !pointer(collection) ||
+        !memory::peek(collection, owner) || owner != entity || !memory::peek(collection + collection_count, count) || count > 128)
+        return 0;
+    for (unsigned i = 0; i < count; ++i) {
+        std::uintptr_t component{}, type{}, animatable{};
+        if (!memory::peek(collection + collection_first + i * collection_step, component) || !pointer(component) ||
+            !memory::peek(component, type) || type != base + ant_driven_vtable)
+            continue;
+        if (!memory::peek(component + driven_animatable, animatable) || !pointer(animatable)) return 0;
+        for (const auto& way : block_ways) {
+            std::uintptr_t holder{}, block{};
+            if (memory::peek(animatable + way[0], holder) && pointer(holder) && memory::peek(holder + way[1], block) && pointer(block) &&
+                memory::peek(block, type) && type == base + states_block_vtable)
+                return block;
+        }
+        return 0;
+    }
+    return 0;
+}
+// The skater's state pages against the step before: every changed word.
+void diff_pages(DarkFlip& f, const NoBailSkater& skater, Row& row) noexcept {
+    std::uintptr_t type{};
+    const bool block_good = f.block && f.block_entity == skater.entity && memory::peek(f.block, type) && type == skater.base + states_block_vtable;
+    if (!block_good || ++f.block_age > 600) {
+        f.block_age = 0;
+        const auto block = find_states_block(skater.base, skater.entity);
+        if (block != f.block) {
+            f.page_known.fill(false);
+            if (block) { // a new states block (new skater or level): find the fix's states again
+                f.places_gen.fetch_add(1, std::memory_order_relaxed);
+                {
+                    std::lock_guard lock(f.names_lock);
+                    f.places.ready = false;
+                }
+                // 1.0: no search here: at a skater load the game has not made all its states yet (a search then
+                // grinds for ~40 s and comes up short). The first landing asks for it instead.
+            }
+        }
+        f.block = block;
+        f.block_entity = skater.entity;
+    }
+    if (!f.block) {
+        f.block_missing.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    row.pages_ok = true;
+    std::array<std::uint32_t, page_words> now{};
+    for (std::size_t p = 0; p < page_count; ++p) {
+        std::uintptr_t page{};
+        if (!memory::peek(f.block + block_pages + p * 8, page) || !pointer(page) || !memory::peek_bytes(page, now.data(), page_bytes)) {
+            f.page_known[p] = false;
+            continue;
+        }
+        if (!f.page_known[p] || f.page_at[p] != page) {
+            f.page_at[p] = page;
+            f.page_last[p] = now;
+            f.page_known[p] = true;
+            continue;
+        }
+        auto& last = f.page_last[p];
+        for (std::size_t w = 0; w < page_words; ++w) {
+            if (now[w] == last[w]) continue;
+            if (row.changes.size() < max_changes)
+                row.changes.push_back({static_cast<std::uint8_t>(p), static_cast<std::uint16_t>(w * 4), last[w], now[w]});
+            else
+                ++row.changes_cut;
+            last[w] = now[w];
+        }
+    }
+}
+void tally(AirSummary& a, const Row& row) noexcept {
+    const auto& p = row.pad.values;
+    const auto step = static_cast<std::int32_t>(a.steps);
+    ++a.steps;
+    a.seconds += row.seconds;
+    a.last_state = row.state;
+    a.wipeout |= row.wipeout;
+    const bool lt = p.left_trigger >= trigger_down, rt = p.right_trigger >= trigger_down;
+    if (lt) { ++a.lt_steps; if (a.first_lt < 0) a.first_lt = step; }
+    if (rt) { ++a.rt_steps; if (a.first_rt < 0) a.first_rt = step; }
+    if (p.buttons & pad_rb) ++a.rb_steps;
+    if (p.buttons & (pad_up | pad_down | pad_left | pad_right)) ++a.dpad_steps;
+    const float ly = stick(p.left_y);
+    a.left_y_min = std::min(a.left_y_min, ly);
+    a.left_y_max = std::max(a.left_y_max, ly);
+    if (row.rig_ok) {
+        a.rig_up_y_min = std::min(a.rig_up_y_min, row.rig_up[1]);
+        const float spin = std::sqrt(row.rig_spin[0] * row.rig_spin[0] + row.rig_spin[1] * row.rig_spin[1] + row.rig_spin[2] * row.rig_spin[2]);
+        a.body_turn_degrees += spin * row.seconds * 57.29578;
+    }
+    if (row.board_ok && row.rig_ok) {
+        const float dot = row.board_up[0] * row.rig_up[0] + row.board_up[1] * row.rig_up[1] + row.board_up[2] * row.rig_up[2];
+        a.board_dot_min = std::min(a.board_dot_min, dot);
+        if (dot < dark_dot) {
+            ++a.dark_steps;
+            if (a.first_dark < 0) a.first_dark = step;
+            if ((lt || rt) && a.first_grab_while_dark < 0) a.first_grab_while_dark = step;
+        }
+    }
+}
+// The fix's states: what the search found, filled in with what the setter hook learned.
+Places effective_places(DarkFlip& f) {
+    Places places;
+    {
+        std::lock_guard lock(f.names_lock);
+        places = f.places;
+    }
+    auto& g = grab_force();
+    for (std::size_t w = 0; w < wanted_count; ++w)
+        if (const auto handle = g.learned[w].load(std::memory_order_relaxed); handle && !places.spot[w].ok) {
+            places.spot[w] = {true, static_cast<std::uint8_t>(handle & 0xfff), static_cast<std::uint16_t>((handle >> 12) & 0x7ff)};
+            ++places.found;
+        }
+    places.ready = true;
+    for (std::size_t w = 0; w < wanted_count; ++w)
+        if (w != w_body_spin && !places.spot[w].ok) places.ready = false; // the spin is only for the log
+    return places;
+}
+std::uintptr_t spot_address(const DarkFlip& f, const Spot& s) noexcept {
+    return s.ok && s.page < page_count && f.page_known[s.page] && pointer(f.page_at[s.page]) ? f.page_at[s.page] + s.place : 0;
+}
+bool state_byte(const DarkFlip& f, const Spot& s, std::uint8_t& value) noexcept {
+    const auto at = spot_address(f, s);
+    return at && memory::peek(at, value) && value <= 1; // a bool state holds 0 or 1; anything else: wrong place
+}
+void fix_step(DarkFlip& f, const Row& row) noexcept {
+    const bool air = air_state(row.state);
+    const bool lt = row.pad.values.left_trigger >= trigger_down, rt = row.pad.values.right_trigger >= trigger_down;
+    if (air && !f.fix_air) {
+        f.fix_air = true;
+        f.assist = {};
+        f.assist.seq = ++f.fix_seq;
+        f.assist.forced_at_start = grab_force().forced.load(std::memory_order_relaxed);
+        f.wrote_last = false;
+        f.prev_lt = lt; // a trigger held from before takeoff is not a press in this air
+        f.prev_rt = rt;
+        f.assist.dir_fixed_at_start = grab_force().dir_fixed.load(std::memory_order_relaxed);
+        grab_force().dir_want.store(0, std::memory_order_release);
+    }
+    grab_force().target.store(0, std::memory_order_relaxed); // forcing is decided again on every step
+    if (!air) {
+        if (f.fix_air) {
+            grab_force().dir_want.store(0, std::memory_order_release); // the direction is only chosen for this air
+            f.assist.dir_fixed = grab_force().dir_fixed.load(std::memory_order_relaxed) - f.assist.dir_fixed_at_start;
+            if (!effective_places(f).ready) f.resolve_wanted.store(true, std::memory_order_relaxed); // landed: the states exist now
+            f.fix_air = false;
+            f.wrote_last = false;
+            f.assist.forced = grab_force().forced.load(std::memory_order_relaxed) - f.assist.forced_at_start;
+            if (f.assist.dark && watch().armed.load(std::memory_order_relaxed)) watch().dark_airs.fetch_add(1, std::memory_order_relaxed);
+            if (f.assist.dark || f.assist.writes) {
+                std::lock_guard lock(f.queue_lock);
+                if (f.assists.size() < 256) f.assists.push_back(f.assist);
+            }
+        }
+        return;
+    }
+    const Places places = effective_places(f);
+    if (!places.ready) return;
+    const auto& sp = places.spot;
+    {
+        auto& w = watch();
+        if (w.on.load(std::memory_order_relaxed)) {
+            w.target[0].store(spot_address(f, sp[w_right_hand_grab]), std::memory_order_relaxed);
+            w.target[1].store(spot_address(f, sp[w_left_hand_grab]), std::memory_order_relaxed);
+            w.target[2].store(spot_address(f, sp[w_flip_faster]), std::memory_order_relaxed);
+            w.target[3].store(spot_address(f, sp[w_wants_dark]), std::memory_order_relaxed);
+            w.is_dark_at.store(spot_address(f, sp[w_is_dark]), std::memory_order_relaxed);
+            w.in_air.store(air, std::memory_order_relaxed);
+        }
+    }
+    auto& a = f.assist;
+    const auto step = static_cast<std::int32_t>(a.steps++);
+    const bool lt_pressed = lt && !f.prev_lt, rt_pressed = rt && !f.prev_rt;
+    f.prev_lt = lt;
+    f.prev_rt = rt;
+    // Did last step's write survive until now?
+    if (f.wrote_last) {
+        std::uint8_t value{};
+        if (memory::peek(f.wrote_at, value) && value) ++a.kept; else ++a.cleared;
+        f.wrote_last = false;
+    }
+    std::uint8_t wants{}, dark{}, front{}, back{}, faster{};
+    if (!state_byte(f, sp[w_wants_dark], wants) || !state_byte(f, sp[w_is_dark], dark) || !state_byte(f, sp[w_front_flip], front) ||
+        !state_byte(f, sp[w_back_flip], back) || !state_byte(f, sp[w_flip_faster], faster)) {
+        ++a.odd;
+        return;
+    }
+    float spin{};
+    if (const auto at = spot_address(f, sp[w_body_spin]); at && memory::peek(at, spin) && std::isfinite(spin)) a.spin_max = std::max(a.spin_max, spin);
+    const bool in_dark = wants || dark;
+    if (a.dir_want && ((a.dir_want > 0 && back) || (a.dir_want < 0 && front))) ++a.dir_wrong; // the game's direction stuck
+    if (in_dark && !a.dark) {
+        a.dark = true;
+        a.first_dark = step;
+    }
+    if (faster) { // the game's body flip is running: nothing to do
+        if (a.latched < 0) {
+            a.latched = step;
+            a.started_before_dark = !a.dark;
+        }
+        return;
+    }
+    if (!f.fix_on.load(std::memory_order_relaxed) || !in_dark || a.gave_up || a.latched >= 0) return;
+    if ((lt_pressed || rt_pressed) && !a.armed) {
+        a.armed = true;
+        a.first_press = step;
+        a.hand = lt_pressed ? 'L' : 'R';
+    }
+    if (!a.armed) return;
+    const bool held = a.hand == 'L' ? lt : rt;
+    if (!held) { a.armed = false; return; } // let go before the flip started: wait for a new press
+    if (!(front || back)) { a.no_stick = true; return; } // no stick, no flip: the flip intent stays the game's own
+    if (a.writes >= assist_max_writes) { a.gave_up = true; return; }
+    if (!grab_force().live.load(std::memory_order_relaxed)) { a.no_hook = true; return; }
+    const auto& target = sp[a.hand == 'L' ? w_right_hand_grab : w_left_hand_grab];
+    std::uint8_t current{};
+    if (!state_byte(f, target, current)) { ++a.odd; return; }
+    const auto at = spot_address(f, target);
+    if (!at) return;
+    grab_force().target.store(at, std::memory_order_relaxed); // the hook keeps it on through the graph's next update
+    if (a.first_write < 0) {
+        a.first_write = step;
+        // The direction, from the stick, the normal way: down = backflip, up = frontflip.
+        const auto y = row.pad.values.left_y;
+        const int want = y <= -16000 ? -1 : y >= 16000 ? 1 : 0;
+        const auto fa = spot_address(f, sp[w_front_flip]), ba = spot_address(f, sp[w_back_flip]);
+        if (want && fa && ba) {
+            auto& g = grab_force();
+            g.dir_front.store(fa, std::memory_order_relaxed);
+            g.dir_back.store(ba, std::memory_order_relaxed);
+            g.raw_front.store(front, std::memory_order_relaxed);
+            g.raw_back.store(back, std::memory_order_relaxed);
+            g.dir_want.store(want, std::memory_order_release);
+            a.dir_want = want;
+        }
+    }
+    ++a.writes;
+    f.wrote_last = true;
+    f.wrote_at = at;
+}
+
+void push(DarkFlip& f, Row&& row) {
+    std::lock_guard lock(f.queue_lock);
+    if (f.rows.size() >= queue_limit) {
+        f.dropped.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    f.rows.push_back(std::move(row));
+}
+// Physics thread, every step of the local skater.
+void on_step(const NoBailSkater& skater, float seconds, bool wipeout) noexcept {
+    auto& f = flip();
+    const bool probe = f.probe_on.load(std::memory_order_acquire), fix = f.fix_on.load(std::memory_order_acquire);
+    if (!probe && !fix) return;
+    try {
+        Row row;
+        row.qpc = qpc_now();
+        row.seconds = seconds;
+        row.wipeout = wipeout;
+        row.mark = f.mark.load(std::memory_order_relaxed);
+        if (!memory::peek(skater.context + sstate::physics_state_offset, row.state)) return;
+        AcquireSRWLockShared(&f.pad_lock);
+        row.pad = f.pad;
+        ReleaseSRWLockShared(&f.pad_lock);
+        row.context_ok = memory::peek(skater.context + context_first, row.context);
+        read_bodies(skater, row);
+        std::uintptr_t trick{}, output{};
+        row.trick_ok = memory::peek(skater.core + sstate::trick_state_offset, trick) && pointer(trick) && memory::peek(trick, row.trick);
+        row.output_ok = row.trick_ok && memory::peek(trick + trick_anim_output, output) && pointer(output) && memory::peek(output, row.output);
+        diff_pages(f, skater, row);
+        fix_step(f, row);
+        if (!probe) return;
+        const bool air = air_state(row.state);
+        if (air && !f.recording) {
+            // Takeoff: a new air, with the steps just before it.
+            f.recording = true;
+            f.post_left = post_rows;
+            row.seq = ++f.seq;
+            for (auto& before : f.pre) {
+                before.seq = row.seq;
+                before.phase = 'p';
+                push(f, std::move(before));
+            }
+            f.pre.clear();
+            f.air = {};
+            f.air.seq = row.seq;
+            f.air.mark = row.mark;
+            f.air.first_state = row.state;
+            f.air_open = true;
+        }
+        if (f.recording) {
+            row.seq = f.seq;
+            if (air) {
+                row.phase = 'a';
+                f.post_left = post_rows; // back in the air (a footplant into 201): the air goes on
+                tally(f.air, row);
+            } else {
+                row.phase = 'l';
+                if (f.air_open) {
+                    f.air.after_state = row.state;
+                    f.air.wipeout |= row.wipeout;
+                    f.air_open = false;
+                    std::lock_guard lock(f.queue_lock);
+                    if (f.airs.size() < 256) f.airs.push_back(f.air);
+                }
+                if (f.post_left) --f.post_left;
+                if (!f.post_left) f.recording = false;
+            }
+            push(f, std::move(row));
+        } else {
+            row.phase = 'p';
+            f.pre.push_back(std::move(row));
+            while (f.pre.size() > pre_rows) f.pre.pop_front();
+        }
+    } catch (...) {
+    }
+}
+
+// ---- the names: a search of the game's memory ------------------------------------------------
+char kind_of(std::string_view name, std::uint8_t& size) noexcept {
+    constexpr std::string_view prefix = "Animation/Dingo/";
+    auto rest = name.substr(prefix.size());
+    if (rest.starts_with("Bool.")) { size = 1; return 'b'; }
+    if (rest.starts_with("Float.")) { size = 4; return 'f'; }
+    if (rest.starts_with("Int") || rest.starts_with("Uint") || rest.starts_with("Enum")) { size = 4; return 'i'; }
+    if (rest.starts_with("Vec3.")) { size = 12; return 'v'; }
+    if (rest.starts_with("Vec4.") || rest.starts_with("Quat")) { size = 16; return 'v'; }
+    size = 4;
+    return '?';
+}
+bool readable(DWORD protect) noexcept {
+    if (protect & (PAGE_GUARD | PAGE_NOACCESS)) return false;
+    const DWORD p = protect & 0xff;
+    return p == PAGE_READONLY || p == PAGE_READWRITE || p == PAGE_WRITECOPY || p == PAGE_EXECUTE_READ || p == PAGE_EXECUTE_READWRITE ||
+           p == PAGE_EXECUTE_WRITECOPY;
+}
+void scan_names(DarkFlip& f, bool targeted, std::uint32_t gen) noexcept {
+    // Background mode: low CPU, I/O and memory priority, so the search cannot starve the game or the PC.
+    const bool background = SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_BEGIN) != 0;
+    const auto began = GetTickCount64();
+    auto map = std::make_shared<NameMap>();
+    try {
+        constexpr std::string_view needle = "Animation/Dingo/";
+        constexpr std::size_t chunk = 4u << 20, back = 0x420;
+        std::vector<char> buffer(chunk + back);
+        std::unordered_map<std::string, std::uint32_t> seen; // name -> handle
+        std::size_t wanted_seen = 0;
+        bool done = false;
+        std::uintptr_t address = 0x10000;
+        MEMORY_BASIC_INFORMATION info{};
+        while (!done && address < memory::highest_user_address && VirtualQuery(reinterpret_cast<const void*>(address), &info, sizeof(info))) {
+            const auto start = reinterpret_cast<std::uintptr_t>(info.BaseAddress);
+            const auto end = start + info.RegionSize;
+            address = end;
+            if (info.State != MEM_COMMIT || !readable(info.Protect) || info.Type != MEM_PRIVATE) continue; // the state objects live on the heap; mapped files are skipped
+            for (std::uintptr_t at = start; !done && at < end; at += chunk) {
+                const std::uintptr_t from = at > start + back ? at - back : start;
+                const std::size_t size = static_cast<std::size_t>(std::min<std::uintptr_t>(end, at + chunk) - from);
+                Sleep(1); // a breath between 4 MB chunks
+                if (!memory::peek_bytes(from, buffer.data(), size)) continue;
+                const std::string_view view(buffer.data(), size);
+                for (auto hit = view.find(needle, 0); hit != std::string_view::npos && hit < size; hit = view.find(needle, hit + 1)) {
+                    const std::uintptr_t text = from + hit;
+                    // The name: printable, ended within 200 bytes.
+                    const auto stop = view.find('\0', hit);
+                    if (stop == std::string_view::npos || stop - hit > 200) continue;
+                    const std::string name(view.substr(hit, stop - hit));
+                    if (!std::all_of(name.begin(), name.end(), [](char c) { return c > 32 && c < 127; })) continue;
+                    // The object pointing at it from up to 0x400 bytes before (its +0x18).
+                    for (std::uintptr_t slot = (text - 8) & ~std::uintptr_t{7}; slot + 0x400 >= text && slot >= from + 8; slot -= 8) {
+                        std::uintptr_t value{};
+                        std::memcpy(&value, buffer.data() + (slot - from), 8);
+                        if (value != text) continue;
+                        const auto object = slot - object_name;
+                        std::uint32_t handle{};
+                        if (!memory::peek(object + object_handle, handle) || !(handle >> 24)) continue;
+                        const std::uint32_t page = handle & 0xfff, place = (handle >> 12) & 0x7ff;
+                        if (page >= page_count || place >= page_bytes) continue;
+                        const auto known = seen.find(name);
+                        if (known != seen.end()) {
+                            if (known->second != handle) ++map->conflicts;
+                            break;
+                        }
+                        seen.emplace(name, handle);
+                        Named named;
+                        named.place = static_cast<std::uint16_t>(place);
+                        named.kind = kind_of(name, named.size);
+                        named.name = name.substr(needle.size());
+                        const std::string_view short_name(named.name);
+                        if (std::find(wanted_names.begin(), wanted_names.end(), short_name) != wanted_names.end()) ++wanted_seen;
+                        map->pages[page].push_back(std::move(named));
+                        ++map->count;
+                        if (targeted && wanted_seen == wanted_count) done = true; // the fix has what it needs
+                        break;
+                    }
+                }
+            }
+        }
+        for (auto& page : map->pages)
+            std::sort(page.begin(), page.end(), [](const Named& a, const Named& b) { return a.place < b.place; });
+    } catch (...) {
+    }
+    map->ms = GetTickCount64() - began;
+    if (background) SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_END);
+    // The fix's states, by name.
+    auto places = std::make_shared<Places>();
+    places->ms = map->ms;
+    for (std::size_t p = 0; p < page_count; ++p)
+        for (const auto& n : map->pages[p])
+            for (std::size_t w = 0; w < wanted_count; ++w)
+                if (n.name == wanted_names[w] && !places->spot[w].ok) {
+                    places->spot[w] = {true, static_cast<std::uint8_t>(p), n.place};
+                    ++places->found;
+                }
+    places->ready = places->found == wanted_count;
+    {
+        std::lock_guard lock(f.names_lock);
+        if (!targeted) f.names = map; // a stopped-early search is not the whole names list
+        if (gen == f.places_gen.load(std::memory_order_relaxed)) {
+            f.places = *places;
+            f.places_result = places;
+        }
+    }
+    f.scanning.store(false, std::memory_order_release);
+}
+bool start_scan(DarkFlip& f, bool targeted) {
+    bool expected = false;
+    if (!f.scanning.compare_exchange_strong(expected, true)) return false;
+    const auto gen = f.places_gen.load(std::memory_order_relaxed);
+    try {
+        std::thread([&f, targeted, gen] { scan_names(f, targeted, gen); }).detach();
+        return true;
+    } catch (...) {
+        f.scanning.store(false);
+    }
+    return false;
+}
+
+// ---- the watch: handler, arming, report ----------------------------------------------------
+std::string now_stamp(); // client side, below
+void save_enabled(bool on); // the switch file, below
+bool peek_u64(std::uint64_t at, std::uint64_t& value) noexcept {
+    if (at < 0x10000 || at > memory::highest_user_address - 8) return false;
+    __try {
+        value = *reinterpret_cast<const std::uint64_t*>(at);
+        return true;
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        return false;
+    }
+}
+bool peek_u8(std::uint64_t at, std::uint8_t& value) noexcept {
+    if (at < 0x10000 || at > memory::highest_user_address) return false;
+    __try {
+        value = *reinterpret_cast<const std::uint8_t*>(at);
+        return true;
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        return false;
+    }
+}
+// The call chain from the trapped context: the instruction after the access, then return addresses.
+void unwind(const CONTEXT& from, std::array<std::uint64_t, watch_frames>& frames) noexcept {
+    CONTEXT c = from;
+    frames.fill(0);
+    frames[0] = c.Rip;
+    for (std::size_t i = 1; i < watch_frames; ++i) {
+        DWORD64 image{};
+        const auto* entry = RtlLookupFunctionEntry(c.Rip, &image, nullptr);
+        if (entry) {
+            void* handler_data{};
+            DWORD64 frame{};
+            RtlVirtualUnwind(UNW_FLAG_NHANDLER, image, c.Rip, const_cast<PRUNTIME_FUNCTION>(entry), &c, &handler_data, &frame, nullptr);
+        } else { // a leaf: the return address is on top of the stack
+            std::uint64_t ret{};
+            if (!peek_u64(c.Rsp, ret)) break;
+            c.Rip = ret;
+            c.Rsp += 8;
+        }
+        if (!c.Rip) break;
+        frames[i] = c.Rip;
+    }
+}
+LONG CALLBACK watch_handler(EXCEPTION_POINTERS* pointers) {
+    if (!pointers || !pointers->ExceptionRecord || !pointers->ContextRecord) return EXCEPTION_CONTINUE_SEARCH;
+    if (pointers->ExceptionRecord->ExceptionCode != EXCEPTION_SINGLE_STEP) return EXCEPTION_CONTINUE_SEARCH;
+    auto& ctx = *pointers->ContextRecord;
+    const auto fired = ctx.Dr6 & 0xf;
+    if (!fired) return EXCEPTION_CONTINUE_SEARCH; // a single step that is not ours
+    ctx.Dr6 &= ~std::uint64_t{0xf};
+    auto& w = watch();
+    w.traps.fetch_add(1, std::memory_order_relaxed);
+    std::size_t slot = 0;
+    while (slot < watch_slots && !(fired & (std::uint64_t{1} << slot))) ++slot;
+    std::array<std::uint64_t, watch_frames> frames{};
+    unwind(ctx, frames);
+    std::uint64_t key = 0xcbf29ce484222325ull ^ slot;
+    for (const auto frame : frames) key = (key ^ frame) * 0x100000001b3ull;
+    if (!key) key = 1;
+    const bool air = w.in_air.load(std::memory_order_relaxed);
+    std::uint8_t dark{};
+    const bool dark_known = peek_u8(w.is_dark_at.load(std::memory_order_relaxed), dark);
+    for (std::size_t i = 0, at = key % watch_table; i < 64; ++i, at = (at + 1) % watch_table) {
+        auto& hit = w.table[at];
+        std::uint64_t expected = 0;
+        if (hit.key.load(std::memory_order_acquire) == key || hit.key.compare_exchange_strong(expected, key)) {
+            if (!hit.filled.load(std::memory_order_acquire) && expected == 0) {
+                hit.slot = static_cast<std::uint8_t>(slot);
+                hit.frames = frames;
+                hit.filled.store(true, std::memory_order_release);
+            }
+            hit.hits.fetch_add(1, std::memory_order_relaxed);
+            if (air) hit.air.fetch_add(1, std::memory_order_relaxed);
+            if (dark_known && dark == 1) hit.dark.fetch_add(1, std::memory_order_relaxed);
+            return EXCEPTION_CONTINUE_EXECUTION;
+        }
+    }
+    w.dropped.fetch_add(1, std::memory_order_relaxed);
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+// Set (targets non-zero) or clear our four debug registers on one thread.
+bool set_thread_watch(DWORD id, const std::array<std::uintptr_t, watch_slots>& targets, bool on) noexcept {
+    HANDLE thread = OpenThread(THREAD_GET_CONTEXT | THREAD_SET_CONTEXT | THREAD_SUSPEND_RESUME, FALSE, id);
+    if (!thread) return false;
+    bool ok = false;
+    if (SuspendThread(thread) != static_cast<DWORD>(-1)) {
+        CONTEXT c{};
+        c.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+        if (GetThreadContext(thread, &c)) {
+            std::uint64_t dr7 = c.Dr7;
+            for (std::size_t i = 0; i < watch_slots; ++i) {
+                dr7 &= ~((std::uint64_t{3} << (i * 2)) | (std::uint64_t{0xf} << (16 + i * 4)));
+                if (on && targets[i]) dr7 |= (std::uint64_t{1} << (i * 2)) | (std::uint64_t{3} << (16 + i * 4)); // local enable, RW = read/write, LEN = 1 byte
+            }
+            c.Dr0 = on ? targets[0] : 0;
+            c.Dr1 = on ? targets[1] : 0;
+            c.Dr2 = on ? targets[2] : 0;
+            c.Dr3 = on ? targets[3] : 0;
+            c.Dr7 = dr7;
+            ok = SetThreadContext(thread, &c) != 0;
+        }
+        ResumeThread(thread);
+    }
+    CloseHandle(thread);
+    return ok;
+}
+// Every thread of the game but this one. The ids are listed first: nothing is allocated while a
+// thread is suspended (it may hold the heap lock).
+void apply_watch(const std::array<std::uintptr_t, watch_slots>& targets, bool on) noexcept {
+    std::vector<DWORD> ids;
+    try {
+        ids.reserve(512);
+        HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if (snapshot == INVALID_HANDLE_VALUE) return;
+        THREADENTRY32 entry{};
+        entry.dwSize = sizeof(entry);
+        const DWORD process = GetCurrentProcessId(), self = GetCurrentThreadId();
+        if (Thread32First(snapshot, &entry))
+            do {
+                if (entry.th32OwnerProcessID == process && entry.th32ThreadID != self) ids.push_back(entry.th32ThreadID);
+                entry.dwSize = sizeof(entry);
+            } while (Thread32Next(snapshot, &entry));
+        CloseHandle(snapshot);
+    } catch (...) {
+        return;
+    }
+    std::uint64_t count = 0;
+    for (const auto id : ids)
+        if (set_thread_watch(id, targets, on)) ++count;
+    watch().threads.store(count, std::memory_order_relaxed);
+}
+void watch_thread() noexcept {
+    auto& w = watch();
+    std::array<std::uintptr_t, watch_slots> applied{};
+    std::uint64_t last_apply = 0;
+    while (w.on.load(std::memory_order_acquire)) {
+        std::array<std::uintptr_t, watch_slots> targets{};
+        bool all = true;
+        for (std::size_t i = 0; i < watch_slots; ++i) {
+            targets[i] = w.target[i].load(std::memory_order_relaxed);
+            all = all && targets[i];
+        }
+        const auto now = GetTickCount64();
+        if (all && (targets != applied || now - last_apply > 1000)) { // new places, or new threads since
+            if (!w.armed.load()) {
+                w.started_ms.store(now);
+                w.dark_airs.store(0);
+            }
+            apply_watch(targets, true);
+            applied = targets;
+            last_apply = now;
+            w.armed.store(true, std::memory_order_release);
+        }
+        if (w.armed.load() && (now - w.started_ms.load() > watch_seconds * 1000 || w.dark_airs.load() >= watch_dark_airs))
+            w.on.store(false, std::memory_order_release);
+        Sleep(100);
+    }
+    if (w.armed.load()) {
+        apply_watch(applied, false);
+        Sleep(200); // let traps already in flight finish
+        w.armed.store(false, std::memory_order_release);
+        w.stopped_ms.store(GetTickCount64());
+        w.report_ready.store(true, std::memory_order_release);
+    }
+}
+bool set_watch(bool on) {
+    auto& w = watch();
+    if (on) {
+        if (w.on.load()) return true;
+        for (auto& hit : w.table) {
+            hit.filled.store(false);
+            hit.key.store(0);
+            hit.hits.store(0);
+            hit.air.store(0);
+            hit.dark.store(0);
+        }
+        w.traps.store(0);
+        w.dropped.store(0);
+        w.report_ready.store(false);
+        if (!w.handler) w.handler = AddVectoredExceptionHandler(1, watch_handler);
+        if (!w.handler) return false;
+        w.on.store(true, std::memory_order_release);
+        try {
+            std::thread(watch_thread).detach();
+        } catch (...) {
+            w.on.store(false);
+            return false;
+        }
+        logging::write(logging::Level::info, logging::Channel::skater, "Dark Flip watch on: it arms once its game states are found, then runs for up to 60 s or 10 dark airs.");
+    } else {
+        w.on.store(false, std::memory_order_release); // the watch thread clears the registers and reports
+    }
+    return true;
+}
+std::string module_of(std::uint64_t address, std::uintptr_t game_base) {
+    if (!address) return "-";
+    static std::uint32_t game_size = [game_base] {
+        IMAGE_DOS_HEADER dos{};
+        IMAGE_NT_HEADERS64 nt{};
+        if (game_base && memory::peek(game_base, dos) && memory::peek(game_base + dos.e_lfanew, nt)) return nt.OptionalHeader.SizeOfImage;
+        return DWORD{};
+    }();
+    if (game_base && address >= game_base && address < game_base + game_size) return std::format("Skate+0x{:x}", address - game_base);
+    HMODULE module{};
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, reinterpret_cast<LPCSTR>(address), &module)) {
+        char path[MAX_PATH]{};
+        GetModuleFileNameA(module, path, MAX_PATH);
+        const std::string name = std::filesystem::path(path).filename().string();
+        return std::format("{}+0x{:x}", name, address - reinterpret_cast<std::uintptr_t>(module));
+    }
+    return std::format("0x{:x}", address);
+}
+std::string code_bytes(std::uint64_t address, std::size_t before, std::size_t after) {
+    std::vector<std::uint8_t> bytes(before + after);
+    if (!address || address < before || !memory::peek_bytes(address - before, bytes.data(), bytes.size())) return "?";
+    std::string text;
+    for (std::size_t i = 0; i < bytes.size(); ++i) text += std::format("{}{:02x}", i == before ? " | " : (i ? " " : ""), bytes[i]);
+    return text;
+}
+void write_watch_report(DarkFlip& f) {
+    auto& w = watch();
+    struct Line {
+        std::uint8_t slot;
+        std::array<std::uint64_t, watch_frames> frames;
+        std::uint32_t hits, air, dark;
+    };
+    std::vector<Line> lines;
+    for (const auto& hit : w.table)
+        if (hit.filled.load())
+            lines.push_back({hit.slot, hit.frames, hit.hits.load(), hit.air.load(), hit.dark.load()});
+    std::sort(lines.begin(), lines.end(), [](const Line& a, const Line& b) { return a.slot != b.slot ? a.slot < b.slot : a.hits > b.hits; });
+    const auto base = f.base.load();
+    std::string path_text = "(no log folder)";
+    try {
+        const auto directory = logging::status().directory;
+        if (!directory.empty()) {
+            const auto path = directory / std::format("dark-flip-watch-{}.txt", now_stamp());
+            std::ofstream out(path, std::ios::binary | std::ios::trunc);
+            out << std::format("# Dark Flip {} watch: {} traps over {} ms, {} dark airs, {} threads, {} places, {} dropped.\n", version, w.traps.load(),
+                               w.stopped_ms.load() - w.started_ms.load(), w.dark_airs.load(), w.threads.load(), lines.size(), w.dropped.load());
+            out << "# Skate.exe base 0x" << std::format("{:x}", base) << ". frame 0 = the instruction after the access (code bytes: 32 before | 16 after); frames 1.. = return addresses (16 before | 8 after).\n";
+            for (const auto& l : lines) {
+                out << std::format("\n[{}] hits {} (in the air {}, while IsDark {})\n", watch_slot_names[l.slot], l.hits, l.air, l.dark);
+                for (std::size_t i = 0; i < watch_frames && l.frames[i]; ++i)
+                    out << std::format("  #{} {}  {}\n", i, module_of(l.frames[i], base), i == 0 ? code_bytes(l.frames[i], 32, 16) : i <= 3 ? code_bytes(l.frames[i], 16, 8) : std::string{});
+            }
+            path_text = path.string();
+        }
+    } catch (...) {
+    }
+    logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip watch done: {} traps at {} places over {} dark airs; {}.", w.traps.load(), lines.size(),
+                 w.dark_airs.load(), path_text);
+}
+
+// ---- client side ---------------------------------------------------------------------------
+std::string now_stamp() {
+    SYSTEMTIME time;
+    GetLocalTime(&time);
+    return std::format("{:04}{:02}{:02}-{:02}{:02}{:02}", time.wYear, time.wMonth, time.wDay, time.wHour, time.wMinute, time.wSecond);
+}
+void open_csv(DarkFlip& f) {
+    if (f.steps_csv.is_open() || f.csv_failed) return;
+    try {
+        const auto directory = logging::status().directory;
+        if (directory.empty()) {
+            f.csv_failed = true;
+            logging::write(logging::Level::warning, logging::Channel::skater, "Dark Flip probe: no log folder; nothing will be recorded.");
+            return;
+        }
+        if (f.stamp.empty()) f.stamp = now_stamp();
+        const auto steps = directory / std::format("dark-flip-steps-{}.csv", f.stamp);
+        const auto states = directory / std::format("dark-flip-states-{}.csv", f.stamp);
+        f.steps_csv.open(steps, std::ios::binary | std::ios::trunc);
+        f.states_csv.open(states, std::ios::binary | std::ios::trunc);
+        if (!f.steps_csv || !f.states_csv) {
+            f.csv_failed = true;
+            logging::log(logging::Level::warning, logging::Channel::skater, "Dark Flip probe: could not write {}.", steps.string());
+            return;
+        }
+        f.steps_csv << "t,seq,mark,phase,state,step_ms,wipeout,pad_age_ms,buttons,A,B,X,Y,LB,RB,DU,DD,DL,DR,LT,RT,LX,LY,RX,RY,"
+                       "board_up_x,board_up_y,board_up_z,board_spin_x,board_spin_y,board_spin_z,"
+                       "rig_up_x,rig_up_y,rig_up_z,rig_spin_x,rig_spin_y,rig_spin_z,board_dot_rig,dark,"
+                       "state_changes,ctx_1380_to_143c,trick_state,anim_output\n";
+        f.states_csv << "t,seq,mark,phase,state,page,place,name,before,after\n";
+        f.csv_start = qpc_now();
+        logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip probe: recording to {} and {}.", steps.string(), states.string());
+    } catch (...) {
+        f.csv_failed = true;
+    }
+}
+std::string hex(const std::uint8_t* bytes, std::size_t count) {
+    std::string text;
+    text.reserve(count * 2);
+    for (std::size_t i = 0; i < count; ++i) text += std::format("{:02x}", bytes[i]);
+    return text;
+}
+std::string decode(const Named& n, std::uint32_t word, std::uint16_t word_at) {
+    const int offset = static_cast<int>(n.place) - static_cast<int>(word_at);
+    if (n.kind == 'b' && offset >= 0 && offset < 4) return std::to_string((word >> (offset * 8)) & 0xff);
+    if ((n.kind == 'f' || n.kind == 'v') && (offset <= 0)) {
+        float value;
+        std::memcpy(&value, &word, 4);
+        return std::format("{:.4g}", value);
+    }
+    if (n.kind == 'i' && offset == 0) return std::to_string(word);
+    return std::format("0x{:08x}", word);
+}
+void write_changes(DarkFlip& f, const Row& r, const NameMap* names, double t) {
+    for (const auto& c : r.changes) {
+        bool named = false;
+        if (names) {
+            const auto& page = names->pages[c.page];
+            // States whose bytes overlap this word and whose bytes changed.
+            auto it = std::lower_bound(page.begin(), page.end(), static_cast<std::uint16_t>(c.word >= 16 ? c.word - 15 : 0),
+                                       [](const Named& n, std::uint16_t place) { return n.place < place; });
+            for (; it != page.end() && it->place < c.word + 4; ++it) {
+                const int first = std::max<int>(it->place, c.word) - c.word;
+                const int last = std::min<int>(it->place + it->size, c.word + 4) - c.word;
+                if (last <= first) continue;
+                bool changed = false;
+                for (int b = first; b < last; ++b)
+                    if (((c.before ^ c.after) >> (b * 8)) & 0xff) changed = true;
+                if (!changed) continue;
+                named = true;
+                f.states_csv << std::format("{:.4f},{},{},{},{},{},0x{:03x},{},{},{}\n", t, r.seq, r.mark, r.phase, r.state, static_cast<unsigned>(c.page), it->place,
+                                            it->name, decode(*it, c.before, c.word), decode(*it, c.after, c.word));
+            }
+        }
+        if (!named)
+            f.states_csv << std::format("{:.4f},{},{},{},{},{},0x{:03x},?,0x{:08x},0x{:08x}\n", t, r.seq, r.mark, r.phase, r.state, static_cast<unsigned>(c.page), c.word,
+                                        c.before, c.after);
+    }
+    if (r.changes_cut)
+        f.states_csv << std::format("{:.4f},{},{},{},{},,,(cut: {} more words changed),,\n", t, r.seq, r.mark, r.phase, r.state, r.changes_cut);
+}
+void write_row(DarkFlip& f, const Row& r, const NameMap* names) {
+    const auto& p = r.pad.values;
+    const double t = qpc_seconds(r.qpc - f.csv_start);
+    const double age = r.pad.qpc ? qpc_seconds(r.qpc - r.pad.qpc) * 1000.0 : -1.0;
+    std::string line = std::format("{:.4f},{},{},{},{},{:.2f},{},{:.1f},{:04x},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}", t, r.seq, r.mark,
+                                   r.phase, r.state, r.seconds * 1000.0f, r.wipeout ? 1 : 0, age, p.buttons, (p.buttons & pad_a) ? 1 : 0,
+                                   (p.buttons & pad_b) ? 1 : 0, (p.buttons & pad_x) ? 1 : 0, (p.buttons & pad_y) ? 1 : 0,
+                                   (p.buttons & pad_lb) ? 1 : 0, (p.buttons & pad_rb) ? 1 : 0, (p.buttons & pad_up) ? 1 : 0,
+                                   (p.buttons & pad_down) ? 1 : 0, (p.buttons & pad_left) ? 1 : 0, (p.buttons & pad_right) ? 1 : 0,
+                                   static_cast<unsigned>(p.left_trigger), static_cast<unsigned>(p.right_trigger), p.left_x, p.left_y, p.right_x, p.right_y);
+    const auto three = [&](bool ok, const std::array<float, 3>& v) {
+        line += ok ? std::format(",{:.3f},{:.3f},{:.3f}", v[0], v[1], v[2]) : std::string(",,,");
+    };
+    three(r.board_ok, r.board_up);
+    three(r.board_ok, r.board_spin);
+    three(r.rig_ok, r.rig_up);
+    three(r.rig_ok, r.rig_spin);
+    if (r.board_ok && r.rig_ok) {
+        const float dot = r.board_up[0] * r.rig_up[0] + r.board_up[1] * r.rig_up[1] + r.board_up[2] * r.rig_up[2];
+        line += std::format(",{:.3f},{}", dot, dot < dark_dot ? 1 : 0);
+    } else {
+        line += ",,";
+    }
+    line += r.pages_ok ? std::format(",{}", r.changes.size() + r.changes_cut) : std::string(",");
+    line += ',';
+    if (r.context_ok)
+        for (std::size_t i = 0; i < context_words; ++i) line += std::format("{}{:08x}", i ? " " : "", r.context[i]);
+    line += ',';
+    // The trick state and its animation output only when they changed since the row before.
+    if (r.trick_ok && (!f.last_trick_ok || r.trick != f.last_trick)) {
+        line += hex(r.trick.data(), r.trick.size());
+        f.last_trick = r.trick;
+    }
+    f.last_trick_ok = r.trick_ok;
+    line += ',';
+    if (r.output_ok && (!f.last_output_ok || r.output != f.last_output)) {
+        line += hex(r.output.data(), r.output.size());
+        f.last_output = r.output;
+    }
+    f.last_output_ok = r.output_ok;
+    line += '\n';
+    f.steps_csv << line;
+    write_changes(f, r, names, t);
+}
+std::string mark_text(DarkFlip& f, std::uint32_t mark) {
+    std::lock_guard lock(f.marks_lock);
+    return mark < f.mark_texts.size() ? f.mark_texts[mark] : std::string{};
