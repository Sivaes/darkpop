+// ---- the grab hook (0.3.0) ---------------------------------------------------------------------
+// The anim graph sets each bool game state through one small function (game build 20260929):
+//   Skate+0x11dd7a0  push rbx / sub rsp,20h / mov rax,rdx / movzx ebx,r8b / lea rdx,[rcx-60h] /
+//                    mov r8b,1 / mov rcx,rax / call <resolve> / mov [rax],bl / ... / ret
+// It returns the address of the byte it wrote (rax). While the fix is forcing (a dark catch, the
+// trigger held, the stick's flip intent on, the flip not started yet), a 0 the graph writes into
+// that one grab intent byte is turned into a 1 right after, inside the graph's own update, before
+// the body flip node reads it. Every other write passes untouched.
+constexpr std::uintptr_t set_bool_rva = 0x11dd7a0;
+constexpr std::array<std::uint8_t, 24> set_bool_bytes{0x40, 0x53, 0x48, 0x83, 0xec, 0x20, 0x48, 0x8b, 0xc2, 0x41, 0x0f, 0xb6,
+                                                     0xd8, 0x48, 0x8d, 0x51, 0xa0, 0x41, 0xb0, 0x01, 0x48, 0x8b, 0xc8, 0xe8};
+using SetBool = void* (*)(void*, void*, std::uint8_t);
+constexpr std::size_t seen_objects = 8192;
+struct GrabForce {
+    std::atomic<bool> live{};                // the hook is in
+    std::atomic<std::uintptr_t> target{};    // 0 = not forcing
+    std::atomic<std::uint32_t> forced{};     // game 0s turned into 1s
+    SetBool original{};
+    // 0.3.1: the states the graph sets are learned here the first time it sets each one (rdx is the
+    // state object: its name at +0x18, its handle at +0x28), so the fix does not wait for the search.
+    std::array<std::atomic<std::uint32_t>, wanted_count> learned{}; // handle, 0 = not seen
+    std::array<std::atomic<std::uintptr_t>, seen_objects> seen{};   // state objects already looked at
+    std::atomic<bool> seen_full{};
+    std::array<std::atomic<std::uintptr_t>, 6> sample{}; // the first few rdx values, for the log (learning diagnostic)
+    std::atomic<std::uint32_t> samples{};
+    // 1.0: the flip direction. After a dark catch the game picks front / back relative to the board, which
+    // is turned around, so stick down gives a frontflip. For flips Dark Flip starts, the direction is set
+    // from the stick (down = backflip, up = frontflip) for the rest of the air: the graph's own "a flip"
+    // stays, only which of the two bits carries it is chosen.
+    std::atomic<std::uintptr_t> dir_front{}, dir_back{};
+    std::atomic<std::uint8_t> raw_front{}, raw_back{};
+    std::atomic<int> dir_want{}; // +1 frontflip, -1 backflip, 0 = leave the game's
+    std::atomic<std::uint32_t> dir_fixed{};
+};
+GrabForce& grab_force() {
+    static auto* value = new GrabForce; // process lifetime: the hook may run until exit
+    return *value;
+}
+// First time a state object comes through: is it one the fix wants? Cheap after that (one lookup).
+void learn_object(GrabForce& g, std::uintptr_t object) noexcept {
+    if (object <= 0x10000 || object >= 0x7fffffffffffull || (object & 7) || g.seen_full.load(std::memory_order_relaxed)) return;
+    std::size_t at = static_cast<std::size_t>((object >> 4) * 0x9e3779b97f4a7c15ull >> 51) % seen_objects;
+    for (std::size_t i = 0; i < 32; ++i, at = (at + 1) % seen_objects) {
+        const auto here = g.seen[at].load(std::memory_order_relaxed);
+        if (here == object) return; // known
+        if (here) continue;
+        std::uintptr_t expected = 0;
+        if (!g.seen[at].compare_exchange_strong(expected, object)) {
+            if (expected == object) return;
+            continue;
+        }
+        if (auto n = g.samples.load(std::memory_order_relaxed); n < g.sample.size() && g.samples.compare_exchange_strong(n, n + 1))
+            g.sample[n].store(object, std::memory_order_relaxed);
+        // Where the state object is: rdx itself, what rdx points at, or rdx at the object's handle.
+        std::uintptr_t deref{};
+        memory::peek(object, deref);
+        for (const std::uintptr_t candidate : {object, deref, object - object_handle}) {
+            std::uintptr_t name_at{};
+            char name[128]{};
+            if (candidate < 0x10000 || !memory::peek(candidate + object_name, name_at) || memory::peek_cstring(name_at, name, sizeof(name)) < 0) continue;
+            constexpr std::string_view prefix = "Animation/Dingo/";
+            const std::string_view text(name);
+            if (!text.starts_with(prefix)) continue;
+            for (std::size_t w = 0; w < wanted_count; ++w)
+                if (text.substr(prefix.size()) == wanted_names[w]) {
+                    std::uint32_t handle{};
+                    if (memory::peek(candidate + object_handle, handle) && (handle >> 24) && (handle & 0xfff) < page_count && ((handle >> 12) & 0x7ff) < page_bytes)
+                        g.learned[w].store(handle, std::memory_order_relaxed);
+                }
+            return;
+        }
+        return;
+    }
+    g.seen_full.store(true, std::memory_order_relaxed);
+}
+void* set_bool_hook(void* a, void* b, std::uint8_t value) {
+    auto& g = grab_force();
+    void* const written = g.original(a, b, value);
+    learn_object(g, reinterpret_cast<std::uintptr_t>(b));
+    const auto target = g.target.load(std::memory_order_relaxed);
+    if (target && reinterpret_cast<std::uintptr_t>(written) == target && value == 0) {
+        *static_cast<volatile std::uint8_t*>(written) = 1;
+        g.forced.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (const int want = g.dir_want.load(std::memory_order_acquire)) {
+        const auto at = reinterpret_cast<std::uintptr_t>(written);
+        const auto front = g.dir_front.load(std::memory_order_relaxed), back = g.dir_back.load(std::memory_order_relaxed);
+        if (front && back && (at == front || at == back)) {
+            (at == front ? g.raw_front : g.raw_back).store(value ? 1 : 0, std::memory_order_relaxed);
+            const std::uint8_t any = g.raw_front.load(std::memory_order_relaxed) | g.raw_back.load(std::memory_order_relaxed);
+            const std::uint8_t f = want > 0 ? any : 0, b = want < 0 ? any : 0;
+            auto* const pf = reinterpret_cast<volatile std::uint8_t*>(front);
+            auto* const pb = reinterpret_cast<volatile std::uint8_t*>(back);
+            if (*pf != f || *pb != b) g.dir_fixed.fetch_add(1, std::memory_order_relaxed);
+            *pf = f;
+            *pb = b;
+        }
+    }
+    return written;
+}
+bool install_grab_hook(std::uintptr_t base) noexcept {
+    auto& g = grab_force();
+    if (g.live.load()) return true;
+    const auto target = base + set_bool_rva;
+    std::array<std::uint8_t, set_bool_bytes.size()> bytes{};
+    if (!memory::peek(target, bytes) || bytes != set_bool_bytes) {
+        logging::log(logging::Level::warning, logging::Channel::skater,
+                     "Dark Flip: the game's bool setter at Skate+0x{:x} is not the one this build knows (another game build?); the fix stays off.", set_bool_rva);
+        return false;
+    }
+    void* original{};
+    auto status = hook_prepare(reinterpret_cast<void*>(target), reinterpret_cast<void*>(&set_bool_hook), &original);
+    if (status == HookOk) {
+        g.original = reinterpret_cast<SetBool>(original);
+        status = hook_enable(reinterpret_cast<void*>(target));
+    }
+    if (status != HookOk) {
+        logging::log(logging::Level::warning, logging::Channel::skater, "Dark Flip: hooking the game's bool setter failed ({}); the fix stays off.", hook_status_string(status));
+        return false;
+    }
+    g.live.store(true, std::memory_order_release);
+    logging::write(logging::Level::info, logging::Channel::skater, "Dark Flip: grab hook in (Skate+0x11dd7a0).");
+    return true;
+}
