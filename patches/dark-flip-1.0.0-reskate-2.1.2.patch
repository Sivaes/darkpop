--- a/Extension/Trainer/trainer_page.cpp
+++ b/Extension/Trainer/trainer_page.cpp
@@ -1055,6 +1055,7 @@ void topic_body(SkateMenu &menu, const Model &model, const CallbacksV3 &callback
