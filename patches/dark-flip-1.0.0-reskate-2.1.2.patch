+// ---- the fix (0.2.x) ------------------------------------------------------------------------
+// The skater's game states the fix reads and writes. Their pages and places are handed out when the
+// game loads (they differ from one launch to the next), so 0.2.1 looks them up by name every session
+// with a short search of the game's heap that stops once all of them are found.
+//   Bool.Intent.WantsDark, Bool.GP.IsDark, Bool.Intent.FrontFlip, Bool.Intent.BackFlip,
+//   Bool.Intent.FlipFaster (on = the body flip is running), Bool.Intent.RightHandGrab (set by LT),
+//   Bool.Intent.LeftHandGrab (set by RT), Float.Physics.BodySpinAccumulatedDegrees (for the log)
+// A body flip starts the step after a grab intent is on while the stick's flip intent is on. In a
+// dark catch the game refuses new grab intents, so the fix raises the grab intent itself, the same
+// state the heelflip glitch leaves on. Only the intent: the grab pose states are never touched.
+enum Wanted : std::size_t { w_wants_dark, w_is_dark, w_front_flip, w_back_flip, w_flip_faster, w_right_hand_grab, w_left_hand_grab, w_body_spin, w_count };
+constexpr std::size_t wanted_count = w_count;
+constexpr std::array<std::string_view, wanted_count> wanted_names{
+    "Bool.Intent.WantsDark", "Bool.GP.IsDark", "Bool.Intent.FrontFlip", "Bool.Intent.BackFlip", "Bool.Intent.FlipFaster",
+    "Bool.Intent.RightHandGrab", "Bool.Intent.LeftHandGrab", "Float.Physics.BodySpinAccumulatedDegrees"};
+struct Spot {
+    bool ok{};
+    std::uint8_t page{};
+    std::uint16_t place{};
+};
+struct Places {
+    bool ready{};
+    std::array<Spot, wanted_count> spot{};
+    std::size_t found{};
+    std::uint64_t ms{};
+};
+constexpr std::int32_t assist_max_writes = 12; // 200 ms of steps; a flip not started by then is left alone
+// ---- the watch (0.2.2): CPU data breakpoints on the fix's states -------------------------------
+// `darkflip watch on` puts a read/write watchpoint (debug registers DR0..DR3, one byte each) on
+// RightHandGrab, LeftHandGrab, FlipFaster and WantsDark on every thread of the game. Each access
+// traps once into a vectored exception handler that records the instruction and the call chain that
+// made it, counted by place, so the code that refuses the grab in a dark catch can be found. It stops
+// after watch_seconds or watch_dark_airs dark airs, and writes logs\dark-flip-watch-<stamp>.txt.
+// The handler never touches the watched bytes (that would trap again inside itself).
+constexpr std::size_t watch_slots = 4, watch_frames = 8, watch_table = 1024;
+constexpr std::array<const char*, watch_slots> watch_slot_names{"Bool.Intent.RightHandGrab (LT)", "Bool.Intent.LeftHandGrab (RT)",
+                                                                 "Bool.Intent.FlipFaster", "Bool.Intent.WantsDark"};
+constexpr std::uint64_t watch_seconds = 60;
+constexpr std::uint32_t watch_dark_airs = 10;
+struct WatchHit {
+    std::atomic<std::uint64_t> key{};   // 0 = free
+    std::atomic<bool> filled{};
+    std::uint8_t slot{};
+    std::array<std::uint64_t, watch_frames> frames{};
+    std::atomic<std::uint32_t> hits{}, air{}, dark{};
+};
+struct Watch {
+    std::atomic<bool> on{}, armed{}, report_ready{};
+    std::array<std::atomic<std::uintptr_t>, watch_slots> target{};
+    std::atomic<std::uintptr_t> is_dark_at{}; // read by the handler (not a watched byte)
+    std::atomic<bool> in_air{};
+    std::atomic<std::uint32_t> dark_airs{};
+    std::atomic<std::uint64_t> traps{}, dropped{}, threads{};
+    std::atomic<std::uint64_t> started_ms{}, stopped_ms{};
+    void* handler{};
+    std::array<WatchHit, watch_table> table{};
+};
+Watch& watch() {
+    static auto* value = new Watch; // process lifetime
+    return *value;
+}
