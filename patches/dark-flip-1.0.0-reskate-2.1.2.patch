+void write_names(DarkFlip& f, const NameMap& names) {
+    try {
+        const auto directory = logging::status().directory;
+        if (directory.empty()) return;
+        if (f.stamp.empty()) f.stamp = now_stamp();
+        std::ofstream out(directory / std::format("dark-flip-names-{}.txt", f.stamp), std::ios::binary | std::ios::trunc);
+        out << std::format("# {} game state names found in {} ms ({} with two handles). page, place, kind, name\n", names.count, names.ms,
+                           names.conflicts);
+        for (std::size_t p = 0; p < page_count; ++p)
+            for (const auto& n : names.pages[p]) out << std::format("{}\t0x{:03x}\t{}\t{}\n", p, n.place, n.kind, n.name);
+    } catch (...) {
+    }
+}
+void flush_probe(DarkFlip& f) {
+    std::vector<Row> rows;
+    std::vector<AirSummary> airs;
+    {
+        std::lock_guard lock(f.queue_lock);
+        rows.swap(f.rows);
+        airs.swap(f.airs);
+    }
+    std::shared_ptr<const NameMap> names;
+    {
+        std::lock_guard lock(f.names_lock);
+        names = f.names;
+    }
+    if (!rows.empty()) {
+        open_csv(f);
+        if (f.steps_csv.is_open()) {
+            for (const auto& row : rows) write_row(f, row, names.get());
+            f.steps_csv.flush();
+            f.states_csv.flush();
+        }
+    }
+    for (const auto& a : airs) log_air(f, a);
+    if (const auto dropped = f.dropped.exchange(0, std::memory_order_relaxed))
+        logging::log(logging::Level::warning, logging::Channel::skater, "Dark Flip probe: {} row(s) dropped (the queue was full).", dropped);
+}
+// The step listener and the pad observer, in while the probe or the fix wants them.
+bool update_hooks(DarkFlip& f) {
+    std::lock_guard lock(f.hooks_lock);
+    const bool want = f.probe_on.load() || f.fix_on.load();
+    if (want && !f.listening) {
+        if (!no_bail_available() || !add_no_bail_step_listener(&on_step)) return false;
+        DingoSDKOverlaySetGamepadObserver(&observe_pad);
+        f.listening = true;
+    } else if (!want && f.listening) {
+        remove_no_bail_step_listener(&on_step);
+        DingoSDKOverlaySetGamepadObserver(nullptr);
+        f.listening = false;
+    }
+    return true;
+}
+bool set_probe(DarkFlip& f, bool on) {
+    if (on == f.probe_on.load(std::memory_order_acquire)) return true;
+    f.probe_on.store(on, std::memory_order_release);
+    if (!update_hooks(f)) {
+        f.probe_on.store(false, std::memory_order_release);
+        return false;
+    }
+    logging::write(logging::Level::info, logging::Channel::skater, on ? "Dark Flip probe on." : "Dark Flip probe off.");
+    return true;
+}
+bool set_fix(DarkFlip& f, bool on) {
+    if (on == f.fix_on.load(std::memory_order_acquire)) return true;
+    f.fix_on.store(on, std::memory_order_release);
+    if (!update_hooks(f)) {
+        f.fix_on.store(false, std::memory_order_release);
+        return false;
+    }
+    if (on) f.resolve_wanted.store(true, std::memory_order_relaxed);
+    save_enabled(on);
+    logging::write(logging::Level::info, logging::Channel::skater, on ? "Dark Flip on." : "Dark Flip off.");
+    return true;
+}
+void log_assists(DarkFlip& f) {
+    std::vector<Assist> list;
+    {
+        std::lock_guard lock(f.queue_lock);
+        list.swap(f.assists);
+    }
+    const auto at = [](std::int32_t step) { return step < 0 ? std::string("-") : std::to_string(step); };
+    const bool detail = f.probe_on.load();
+    for (const auto& a : list) {
+        if (!detail) { // 1.0: one short line per dark air where it mattered
+            const char* trigger = a.hand == 'L' ? "LT" : "RT";
+            if (a.writes && a.latched >= 0)
+                logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip: dark {} (air {}, {} at step {}, the flip started at step {}{}).",
+                             a.dir_want > 0 ? "frontflip" : a.dir_want < 0 ? "backflip" : "body flip", a.seq, trigger, at(a.first_press), a.latched,
+                             a.dir_want == 0 ? ", stick not held up or down: the game's direction"
+                             : a.dir_wrong > 2 ? std::format(", but the game kept its own direction on {} step(s)", a.dir_wrong)
+                             : a.dir_fixed ? std::format(", direction set from the stick ({} fix(es))", a.dir_fixed) : std::string(", the game's direction was already right"));
+            else if (a.writes)
+                logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip: air {}: {} held in a dark catch with the stick, but the body flip did not start.", a.seq, trigger);
+            else if (a.no_hook)
+                logging::write(logging::Level::warning, logging::Channel::skater, "Dark Flip: a dark catch with a trigger press, but the grab hook is not in (see the start of ReSkate.log).");
+            continue;
+        }
+        std::string what;
+        if (a.started_before_dark) what = std::format("the body flip started before the dark catch, at step {} (the glitch timing)", a.latched);
+        else if (a.writes && a.latched >= 0) what = std::format("grab intent forced on {} step(s) from step {} (the hook turned {} game write(s) of 0 into 1; on at the next step {}, off {}); body flip STARTED at step {}",
+                                                                  a.writes, a.first_write, a.forced, a.kept, a.cleared, a.latched);
+        else if (a.writes) what = std::format("grab intent forced on {} step(s) from step {} (the hook turned {} game write(s) of 0 into 1; on at the next step {}, off {}); body flip did NOT start{}",
+                                              a.writes, a.first_write, a.forced, a.kept, a.cleared, a.gave_up ? " (gave up)" : "");
+        else if (a.no_hook) what = "the grab hook is not in (see the start of ReSkate.log): nothing done";
+        else if (a.first_press >= 0 && a.no_stick) what = "trigger pressed but no stick flip intent: nothing written";
+        else if (a.first_press >= 0) what = "trigger pressed, nothing written";
+        else if (a.latched >= 0) what = std::format("body flip running from step {}", a.latched);
+        else what = "no trigger press in the dark catch";
+        if (a.dir_want)
+            what += std::format("; direction {} from the stick ({} fix(es), the game's own on {} step(s))", a.dir_want > 0 ? "front" : "back", a.dir_fixed, a.dir_wrong);
+        logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip: air {} dark from step {}, {} {}; {}; body spin {:.0f} deg{}.", a.seq, at(a.first_dark),
+                     a.hand == 'L' ? "LT" : a.hand == 'R' ? "RT" : "trigger", a.first_press >= 0 ? "at step " + at(a.first_press) : std::string("not pressed"), what,
+                     a.spin_max, a.odd ? std::format(" ({} step(s) skipped: a state read was not 0 or 1)", a.odd) : std::string{});
+    }
+}
+// The on/off switch is kept in %LOCALAPPDATA%\ReSkate\dark-flip.ini ("enabled=1" or "enabled=0"); on when missing.
+std::filesystem::path settings_path() {
+    wchar_t buffer[MAX_PATH]{};
+    const auto length = GetEnvironmentVariableW(L"LOCALAPPDATA", buffer, MAX_PATH);
+    if (!length || length >= MAX_PATH) return {};
+    return std::filesystem::path(buffer) / L"ReSkate" / L"dark-flip.ini";
+}
+bool load_enabled() {
+    try {
+        const auto path = settings_path();
+        if (path.empty()) return true;
+        std::ifstream in(path);
+        std::string line;
+        while (std::getline(in, line))
+            if (line.starts_with("enabled=")) return line.substr(8, 1) != "0";
+    } catch (...) {
+    }
+    return true;
+}
+void save_enabled(bool on) {
+    try {
+        const auto path = settings_path();
+        if (path.empty()) return;
+        std::filesystem::create_directories(path.parent_path());
+        std::ofstream out(path, std::ios::trunc);
+        out << "# Dark Flip: body flips out of a dark catch. 1 = on, 0 = off.\nenabled=" << (on ? 1 : 0) << "\n";
+    } catch (...) {
+    }
+}
+std::string status_text(DarkFlip& f) {
+    if (!f.started.load(std::memory_order_acquire)) return "Dark Flip is unavailable.";
+    std::shared_ptr<const NameMap> names;
+    {
+        std::lock_guard lock(f.names_lock);
+        names = f.names;
+    }
+    const auto mark = mark_text(f, f.mark.load());
+    const bool ready = effective_places(f).ready;
+    if (!f.probe_on.load() && !watch().on.load())
+        return std::format("Dark Flip {}: {}{}{}.", version, f.fix_on.load() ? "ON (LT / RT with the stick in a dark catch starts the body flip)" : "off",
+                           ready ? ", ready" : ", getting ready (do an ollie or a flip)", grab_force().live.load() ? "" : ", but the grab hook is NOT in (another game build?)");
+    return std::format("Dark Flip {}: {}{}. Probe {}{}. Airs recorded: {}. State names: {}. Marker: {}.", version,
+                       f.fix_on.load() ? "ON (a grab press in a dark catch starts the body flip)" : "off",
+                       ready ? ", its game states found" : f.scanning.load() ? ", finding its game states..." : ", its game states not found yet (they are found when the skater loads)",
+                       f.probe_on.load() ? "ON" : "off",
+                       f.probe_on.load() ? " (logs\\dark-flip-*.csv)" : no_bail_available() ? "" : " (unavailable: No Bail's hooks did not start)",
+                       f.seq, f.scanning.load() ? std::string("searching...") : names ? std::format("{} found", names->count) : std::string("not searched yet"),
+                       mark.empty() ? std::string("none") : mark);
+}
+} // namespace
+
+bool start(std::uintptr_t image_base) noexcept {
+    auto& f = flip();
+    if (f.started.load(std::memory_order_acquire)) return true;
+    f.base.store(image_base, std::memory_order_release);
+    f.fix_on.store(load_enabled(), std::memory_order_release);
+    f.started.store(true, std::memory_order_release);
+    logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip {} started: {} (LT / RT with the stick in a dark catch starts the game's own body flip; SANDBOX > TUNE > TRICKLINING or `darkflip on|off`).",
+                 version, f.fix_on.load() ? "on" : "off");
+    const HookBatch batch; // the grab hook attaches in one transaction
+    install_grab_hook(image_base);
+    if (!update_hooks(f))
+        logging::write(logging::Level::warning, logging::Channel::skater,
+                       "Dark Flip could not start: it follows the skater's physics steps through No Bail's hooks (not started, or no free step listener).");
+    // 1.0: the probe (per-step CSVs, large) is off by default: `darkflip probe on`.
+    return true;
+}
+
+void on_client_tick(std::uintptr_t) noexcept {
+    auto& f = flip();
+    if (!f.started.load(std::memory_order_acquire)) return;
+    try {
+        // 0.1.1: the names are searched only on `darkflip names` (0.1.0 searched on the first air and,
+        // reading every mapped view too, could page the whole game in and starve the PC).
+        static std::shared_ptr<const NameMap> written;
+        std::shared_ptr<const NameMap> names;
+        {
+            std::lock_guard lock(f.names_lock);
+            names = f.names;
+        }
+        if (names && names != written) {
+            written = names;
+            write_names(f, *names);
+            logging::log(logging::Level::info, logging::Channel::skater,
+                         "Dark Flip probe: found {} of the skater's game state names in {} ms ({} with two handles); logs\\dark-flip-names-*.txt.",
+                         names->count, names->ms, names->conflicts);
+        }
+        if (f.fix_on.load() && !f.scanning.load() && f.resolve_wanted.exchange(false, std::memory_order_relaxed) && !start_scan(f, true))
+            f.resolve_wanted.store(true, std::memory_order_relaxed); // busy: next tick
+        std::shared_ptr<const Places> result;
+        {
+            std::lock_guard lock(f.names_lock);
+            result = f.places_result;
+        }
+        static bool said_ready{};
+        static std::uint32_t said_gen{};
+        const auto effective = effective_places(f);
+        if (const auto gen = f.places_gen.load(std::memory_order_relaxed); gen != said_gen) {
+            said_gen = gen;
+            said_ready = false;
+        }
+        if (effective.ready) {
+            if (!said_ready) {
+                said_ready = true;
+                auto& g = grab_force();
+                std::string where;
+                for (std::size_t w = 0; w < wanted_count; ++w)
+                    where += std::format("{}{} {}", w ? ", " : "", wanted_names[w],
+                                         !effective.spot[w].ok ? std::string("not found (log only)")
+                                                               : std::format("{}:0x{:03x} ({})", effective.spot[w].page, effective.spot[w].place,
+                                                                             g.learned[w].load() ? "from the game's setter" : "from the search"));
+                logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip: ready; its game states: {}.", where);
+                bool any_learned = false;
+                for (const auto& l : g.learned) any_learned = any_learned || l.load();
+                if (!any_learned) { // a diagnostic for the setter's learning path (once): what its rdx points at
+                    std::string dump;
+                    for (std::size_t i = 0; i < g.samples.load() && i < g.sample.size(); ++i) {
+                        const auto object = g.sample[i].load();
+                        dump += std::format(" [rdx 0x{:x}:", object);
+                        for (std::uintptr_t off = 0; off < 0x40; off += 8) {
+                            std::uint64_t q{};
+                            if (!memory::peek(object + off, q)) { dump += " ?"; break; }
+                            char text[48]{};
+                            const auto n = memory::peek_cstring(q, text, sizeof(text));
+                            dump += n > 3 ? std::format(" +{:x}=\"{}\"", off, text) : std::format(" +{:x}={:x}", off, q);
+                        }
+                        dump += "]";
+                    }
+                    logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip: diagnostic, the setter's arguments:{}", dump);
+                }
+            }
+        }
+        if (result && result != f.places_said) {
+            f.places_said = result;
+            if (!effective.ready) {
+                std::string missing;
+                for (std::size_t w = 0; w < wanted_count; ++w)
+                    if (!effective.spot[w].ok) missing += std::string(missing.empty() ? "" : ", ") + std::string(wanted_names[w]);
+                logging::log(logging::Level::info, logging::Channel::skater,
+                             "Dark Flip: the search found {} of its {} game states in {} ms; still missing {} (they are also picked up the first time the game sets them).",
+                             result->found, wanted_count, result->ms, missing);
+            }
+        }
+        flush_probe(f);
+        log_assists(f);
+        if (watch().report_ready.exchange(false, std::memory_order_acq_rel)) write_watch_report(f);
+        static std::uint64_t said{};
+        if (const auto missing = f.block_missing.exchange(0, std::memory_order_relaxed); missing && f.probe_on.load() && GetTickCount64() > said) {
+            said = GetTickCount64() + 30000;
+            logging::log(logging::Level::warning, logging::Channel::skater,
+                         "Dark Flip probe: the skater's animation state pages were not found on {} step(s); the state diffs are missing.", missing);
+        }
+    } catch (...) {
+    }
+}
+
+bool enabled() noexcept { return flip().fix_on.load(std::memory_order_acquire); }
+bool ready() noexcept { return flip().started.load() && grab_force().live.load() && effective_places(flip()).ready; }
+bool hook_in() noexcept { return grab_force().live.load(); }
+bool set_enabled(bool on) noexcept {
+    try {
+        return set_fix(flip(), on);
+    } catch (...) {
+        return false;
+    }
+}
+std::string command(const std::vector<std::string>& words) {
+    auto& f = flip();
+    const auto verb = words.empty() ? std::string("status") : words[0];
+    if (verb == "status" || verb.empty()) return status_text(f);
+    if (!f.started.load()) return status_text(f);
+    if (verb == "watch") {
+        const auto arg = words.size() > 1 ? words[1] : std::string{};
+        if (arg != "on" && arg != "off") return "Usage: darkflip watch on|off";
+        if (!set_watch(arg == "on")) return "The watch could not start.";
+        return arg == "on" ? "Dark Flip watch on: do dark catches with LT / RT and the stick; it stops by itself after 60 s or 10 dark airs and writes logs\\dark-flip-watch-*.txt."
+                           : "Dark Flip watch stopping; ReSkate.log says when its report is written.";
+    }
+    if (verb == "on" || verb == "off") {
+        if (!set_fix(f, verb == "on")) return "Dark Flip could not start: No Bail's hooks did not start, or no step listener is free.";
+        return status_text(f);
+    }
+    if (verb == "probe") {
+        const auto arg = words.size() > 1 ? words[1] : std::string{};
+        if (arg != "on" && arg != "off") return "Usage: darkflip probe on|off";
+        if (!set_probe(f, arg == "on")) return "The probe could not start: No Bail's hooks did not start, or no step listener is free.";
+        return status_text(f);
+    }
+    if (verb == "mark") {
+        std::string text;
+        for (std::size_t i = 1; i < words.size(); ++i) text += (i > 1 ? " " : "") + words[i];
+        std::uint32_t index;
+        {
+            std::lock_guard lock(f.marks_lock);
+            f.mark_texts.push_back(text);
+            index = static_cast<std::uint32_t>(f.mark_texts.size() - 1);
+        }
+        f.mark.store(index, std::memory_order_relaxed);
+        logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip probe: marker {} \"{}\" from air {} on.", index, text, f.seq + 1);
+        return std::format("Marker {} \"{}\": the next airs are tagged with it.", index, text);
+    }
+    if (verb == "names") {
+        start_scan(f, false);
+        return "Searching the game's memory for the skater's game state names, in the background (up to a minute; ReSkate.log says when it is done).";
+    }
+    return "Usage: darkflip on|off | darkflip watch on|off | darkflip status | darkflip probe on|off | darkflip mark <text> | darkflip names";
+}
+} // namespace dingosdk::dark_flip
